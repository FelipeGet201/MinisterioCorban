    function crearTarjetaCompositeQR(qrCanvas, nombre, esPagado, subtexto) {
        var scale = 2; // Para que se vea nítido en pantallas de alta densidad
        var w = 400;
        var h = 480;
        var canvas = document.createElement('canvas');
        canvas.width = w * scale;
        canvas.height = h * scale;
        var ctx = canvas.getContext('2d');
        ctx.scale(scale, scale); // Todo el dibujo se hace en coordenadas relativas a w y h

        // Fondo Blanco
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, w, h);

        // Borde elegante exterior
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 4;
        ctx.strokeRect(2, 2, w - 4, h - 4);

        // Header banner tenue (verde o rojo)
        ctx.fillStyle = esPagado ? '#F0FDF4' : '#FEF2F2';
        ctx.fillRect(4, 4, w - 8, 85);

        // Insignia Pequeña: ✔️ o ❌
        ctx.save();
        if (esPagado) {
            ctx.fillStyle = '#16A34A';
            ctx.beginPath();
            ctx.arc(40, 46, 22, 0, 2 * Math.PI);
            ctx.fill();

            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 24px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('✓', 40, 46);
        } else {
            ctx.fillStyle = '#DC2626';
            ctx.beginPath();
            ctx.arc(40, 46, 22, 0, 2 * Math.PI);
            ctx.fill();

            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 22px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('✕', 40, 46);
        }
        ctx.restore();

        // Nombre Completo de la persona (Multilínea sin recortar)
        ctx.fillStyle = '#0F172A';
        var fontSize = 16;
        var nombreTexto = (nombre || 'ASISTENTE').trim();
        if (nombreTexto.length > 35) fontSize = 13;
        else if (nombreTexto.length > 25) fontSize = 14;

        ctx.font = 'bold ' + fontSize + 'px sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';

        var palabras = nombreTexto.split(' ');
        var lineas = [];
        var lineaAct = '';
        var maxAnchoTexto = 300;

        for (var i = 0; i < palabras.length; i++) {
            var prueba = lineaAct + (lineaAct ? ' ' : '') + palabras[i];
            if (ctx.measureText(prueba).width <= maxAnchoTexto) {
                lineaAct = prueba;
            } else {
                lineas.push(lineaAct);
                lineaAct = palabras[i];
            }
        }
        if (lineaAct) lineas.push(lineaAct);

        var startY = 16;
        for (var i = 0; i < lineas.length; i++) {
            ctx.fillText(lineas[i], 76, startY + (i * (fontSize + 2)));
        }
        
        ctx.font = 'bold 12px sans-serif';
        ctx.fillStyle = esPagado ? '#15803D' : '#B91C1C';
        ctx.fillText(esPagado ? '✓ PAGADO / LIQUIDADO' : '✕ PAGO PENDIENTE', 76, startY + (lineas.length * (fontSize + 2)) + 6);

        // Línea separadora
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(10, 89);
        ctx.lineTo(w - 10, 89);
        ctx.stroke();

        // Dibujar QR en el centro
        var qrSize = 300;
        var qrX = (w - qrSize) / 2;
        var qrY = 105;
        ctx.drawImage(qrCanvas, qrX, qrY, qrSize, qrSize);

        // Pie de página
        ctx.fillStyle = '#64748B';
        ctx.font = '12px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        if (subtexto) {
            ctx.fillText(subtexto, w / 2, h - 26);
        }
        ctx.font = 'bold 11px sans-serif';
        ctx.fillStyle = '#334155';
        ctx.fillText('CÓDIGO DE ACCESO OFICIAL - MINISTERIO CORBÁN', w / 2, h - 10);

        return canvas;
    }

    function mostrarQRInscrito(idAsistente, nombre, tokenExterno, modalidad, esPagado) {
        var container = document.getElementById('qrCodeContainerInscrito');
        container.innerHTML = '';

        var tempDiv = document.createElement('div');
        tempDiv.style.display = 'none';
        document.body.appendChild(tempDiv);

        var urlCompleto = window.location.origin + '@Url.Action("Pagar", "Eventos")' + '?token=' + (tokenExterno || idAsistente);

        new QRCode(tempDiv, {
            text: urlCompleto,
            width: 600, // Doble resolución para nitidez
            height: 600,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        });

        setTimeout(() => {
            var rawCanvas = tempDiv.querySelector('canvas');
            var btnDownload = document.getElementById('btnDownloadQRInscrito');
            if (rawCanvas) {
                var finalCanvas = crearTarjetaCompositeQR(rawCanvas, nombre, !!esPagado, 'ID: #' + idAsistente + ' - ' + modalidad);
                finalCanvas.style.maxWidth = '100%';
                finalCanvas.style.height = 'auto';
                finalCanvas.style.borderRadius = '16px';
                finalCanvas.style.boxShadow = '0 4px 16px rgba(0,0,0,0.08)';

                container.innerHTML = '';
                container.appendChild(finalCanvas);

                btnDownload.href = finalCanvas.toDataURL("image/png");
                btnDownload.download = (esPagado ? 'QR_PAGADO_' : 'QR_PENDIENTE_') + idAsistente + '_' + nombre.replace(/ /g, '_') + '.png';
                btnDownload.style.display = 'inline-block';
            } else {
                btnDownload.style.display = 'none';
            }
            if (tempDiv.parentNode) tempDiv.parentNode.removeChild(tempDiv);
        }, 250);

        new bootstrap.Modal(document.getElementById('modalQRInscrito')).show();
    }
</script>

