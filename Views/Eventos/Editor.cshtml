@using RedAJP.Globales
@using RedAJP.Models
@using RedAJP.Controllers
@model RedAJP.Models.EditorEventoViewModel
@{
    Layout = "Principal";

    int idEvento = ViewBag.Id_Evento != null ? Convert.ToInt32(ViewBag.Id_Evento) : 0;
    string sIdEncriptado = ViewBag.Id_Encriptado_Evento as string ?? "";
    string titulo = ViewBag.Titulo as string ?? "";
    string descripcion = ViewBag.Descripcion as string ?? "";
    string imagenUrl = ViewBag.Imagen_Url as string ?? "";
    string fechaInicio = ViewBag.Fecha_Inicio is DateTime fi ? fi.ToString("yyyy-MM-ddTHH:mm") : "";
    string fechaFin = ViewBag.Fecha_Fin is DateTime ff ? ff.ToString("yyyy-MM-ddTHH:mm") : "";
    string costo = ViewBag.Costo_Entrada?.ToString() ?? "0.00";
    string cupo = ViewBag.Cupo_Maximo?.ToString() ?? "0";
    bool reqRegistro = ViewBag.Requiere_Registro != null && (bool)ViewBag.Requiere_Registro;
    bool permitirPago = ViewBag.Permitir_Pago != null && (bool)ViewBag.Permitir_Pago;
    bool esDestacado = ViewBag.Es_Destacado != null && (bool)ViewBag.Es_Destacado;
    bool activo = ViewBag.Activo != null && (bool)ViewBag.Activo;
    bool tienePagos = ViewBag.TienePagos != null && (bool)ViewBag.TienePagos;
    bool esPrivado = ViewBag.Es_Privado != null && (bool)ViewBag.Es_Privado;
    bool permitirParciales = ViewBag.Permitir_Pagos_Parciales != null && (bool)ViewBag.Permitir_Pagos_Parciales;
    int tipoRegistro = ViewBag.Tipo_Registro != null ? Convert.ToInt32(ViewBag.Tipo_Registro) : 1;
    bool permitirTransferencia = ViewBag.Permitir_Transferencia as bool? ?? false;
    bool permitirPagoTarjeta = ViewBag.Permitir_Pago_Tarjeta as bool? ?? true;
    bool cobrarComisionExtra = ViewBag.Cobrar_Comision_Extra as bool? ?? true;
    var listaCompleta = ViewBag.CalendarioPagos as List<CalendarioPagoItem> ?? new List<CalendarioPagoItem>();
    var calendario = listaCompleta.Where(x => x.Id_Subtipo == 0).ToList();
    var preguntas = ViewBag.Preguntas as List<PreguntaConfigitem> ?? new List<PreguntaConfigitem>();
    var subtipos = ViewBag.Subtipos as List<SubtipoEventoItem> ?? new List<SubtipoEventoItem>();
    var galeria = ViewBag.Galeria as List<FotoGaleriaItem> ?? new List<FotoGaleriaItem>();
    var inscriptores = ViewBag.Inscriptores as List<InscriptorItem> ?? new List<InscriptorItem>();
    var todosUsuarios = ViewBag.TodosUsuarios as List<dynamic> ?? new List<dynamic>();
    var gruposDisponibles = ViewBag.ListaGrupos as List<dynamic> ?? new List<dynamic>();
    int idGrupoSeleccionado = ViewBag.Id_Grupo_Usuarios != null ? (int)ViewBag.Id_Grupo_Usuarios : 0;
    
    // Vinculación por Evento
    int idEventoVinculado = ViewBag.Id_Evento_Vinculado ?? 0;
    string subtiposVinculados = ViewBag.Subtipos_Vinculados_Acceso as string ?? "";
    var eventosVinculables = ViewBag.EventosVinculables as List<dynamic> ?? new List<dynamic>();

    // Encuesta Requisito
    var encuestasReq = ViewBag.ListaEncuestasRequisito as List<dynamic> ?? new List<dynamic>();
    int idEncuestaSeleccionada = ViewBag.Id_Encuesta_Requisito != null ? (int)ViewBag.Id_Encuesta_Requisito : 0;

    string claveCuenta = ViewBag.ClaveCuenta as string ?? "DEFAULT";
    var listaBancos = ViewBag.ListaBancos as Dictionary<string, string>;
    string idsInscriptoresStr = string.Join(",", inscriptores.Select(x => x.Id_Usuario));
    bool bPuedeBorrarEvento = User.TienePermiso(RedAJP.Globales.Parametros.Modulos.Eventos, RedAJP.Globales.Parametros.Permisos.Borrar);
    var historialRegistros = ViewBag.InscriptoresConHistorial as List<int> ?? new List<int>();
    bool hayRegistrados = historialRegistros.Any();
    ViewData["Title"] = (idEvento == 0 ? "Nuevo" : "Editar") + " Evento";
}
<link href="~/lib/select2/select2.min.css" rel="stylesheet" />
<style>
    #dropzoneGaleria.dragover { background-color: #e9ecef !important; border-color: #0d6efd !important; transform: scale(1.02); }
    .select2-container .select2-selection--single { height: 38px !important; border: 1px solid #ced4da; border-radius: 0.375rem; }
    .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 38px; padding-left: 12px; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
    .preview-card { cursor: grab; transition: transform 0.2s; }
    .preview-card:active { cursor: grabbing; transform: scale(1.05); z-index: 10; }
    .preview-img { height: 120px; width: 100%; object-fit: cover; border-radius: 6px 6px 0 0; }
    .input-group > .select2-container { flex: 1 1 auto; width: 1% !important; }
    .input-group > .select2-container .select2-selection--single { border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important; }
</style>

<script>
    window.addEventListener('load', function() { if (typeof activarMenu === 'function') activarMenu('menu-eventos'); });
</script>

<div class="container py-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h3>
                        <div class="d-flex gap-2">
                            @if (idEvento > 0 && bPuedeBorrarEvento && !hayRegistrados)
                            {
                                <form id="formBorrarEvento" action="@Url.Action("Eliminar", "Eventos")" method="post" class="d-none">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@idEvento" />
                                </form>
                                <button type="button" class="btn btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#modalConfirmarBorrado">
                                    <i class="fa-solid fa-trash me-2"></i> Borrar Evento
                                </button>
                            }
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill">
                                <i class="fa-solid fa-arrow-left me-2"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <form method="post" action="@Url.Action("Guardar")" id="formEditor" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id_Evento" value="@idEvento" />

                        <ul class="nav nav-tabs nav-justified bg-light" id="myTab" role="tablist">
                            <li class="nav-item"><button class="nav-link active py-3 fw-bold rounded-0 text-dark" data-bs-toggle="tab" data-bs-target="#panel-general" type="button"><i class="fa-solid fa-circle-info me-2 text-primary"></i> General</button></li>
                            <li class="nav-item"><button class="nav-link py-3 fw-bold rounded-0 text-dark" data-bs-toggle="tab" data-bs-target="#panel-registro" type="button"><i class="fa-solid fa-clipboard-list me-2 text-primary"></i> Registro y Costos</button></li>
                            <li class="nav-item"><button class="nav-link py-3 fw-bold rounded-0 text-dark" data-bs-toggle="tab" data-bs-target="#panel-adicionales" type="button"><i class="fa-solid fa-cart-plus me-2 text-primary"></i> Productos Extra</button></li>
                            <li class="nav-item"><button class="nav-link py-3 fw-bold rounded-0 text-dark" data-bs-toggle="tab" data-bs-target="#panel-media" type="button"><i class="fa-solid fa-images me-2 text-primary"></i> Galería</button></li>
                            <li class="nav-item"><button class="nav-link py-3 fw-bold rounded-0 text-dark" data-bs-toggle="tab" data-bs-target="#panel-avanzado" type="button"><i class="fa-solid fa-shield-halved me-2 text-primary"></i> Avanzado</button></li>
                        </ul>

                        <div class="tab-content p-4 p-md-5">

                            <div class="tab-pane fade show active" id="panel-general">
                                <div class="row g-4">
                                    <div class="col-md-8">
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Título del Evento</label>
                                            <input type="text" name="Titulo" class="form-control form-control-lg border-primary border-opacity-25" value="@titulo" required />
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Descripción</label>
                                            <textarea name="Descripcion" class="form-control" rows="6">@descripcion</textarea>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-md-6"><label class="form-label fw-bold">Inicio</label><input type="datetime-local" id="txtFechaInicio" name="Fecha_Inicio" class="form-control" value="@fechaInicio" required /></div>
                                            <div class="col-md-6"><label class="form-label fw-bold">Fin</label><input type="datetime-local" id="txtFechaFin" name="Fecha_Fin" class="form-control" value="@fechaFin" /></div>
                                        </div>
                                    </div>

                                    <div class="col-md-4 border-start ps-4">
                                        <label class="form-label fw-bold text-dark">Imagen Portada</label>
                                        @if (!string.IsNullOrEmpty(imagenUrl))
                                        {
                                            <div class="mb-3 position-relative">
                                                <img src="@imagenUrl" class="img-fluid rounded shadow-sm border" style="max-height: 200px; width: 100%; object-fit: cover;" />
                                                <span class="badge bg-success position-absolute top-0 end-0 m-2">Actual</span>
                                            </div>
                                            <input type="hidden" name="Imagen_Url" value="@imagenUrl" id="hdnImagenUrl" />
                                        }
                                        <input type="file" name="fotoPortadaNueva" id="filePortada" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp" />
                                        <div class="form-text small mb-4">Max 10MB. Formatos: JPG, PNG, WEBP.</div>

                                        @if (idEvento > 0)
                                        {
                                            <div id="wrapperBtnGrafico" class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-4">
                                                <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>Edición Gráfica</h6>
                                                <p class="small text-muted mb-3">Configura sellos de "Agotado" sobre la imagen de portada de forma visual.</p>
                                                
                                                <a href="@Url.Action("EditorImagenPortada", new { sid = sIdEncriptado })"
                                                id="btnEditorGrafico" 
                                                class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm">
                                                    <i class="fa-solid fa-arrows-to-dot me-2"></i> Abrir Editor de Mapa
                                                </a>

                                                <div id="alertaCambiosImagen" class="alert alert-warning mt-2 small py-2 d-none">
                                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                                                    Has seleccionado una <strong>nueva imagen</strong> o modificado datos. Guarda para habilitar el editor.
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="panel-registro">
                                <div class="form-check form-switch p-3 bg-light rounded border mb-4">
                                    <input class="form-check-input me-3" type="checkbox" id="chkRegistro" name="Requiere_Registro" value="true" @(reqRegistro ? "checked" : "") onchange="toggleRegistro()">
                                    <input type="hidden" name="Requiere_Registro" value="false" />
                                    <label class="form-check-label fw-bold m-0" for="chkRegistro">Habilitar Registro de Asistentes</label>
                                </div>

                                <div id="panelRegistroContent" style="display:none;">
                                    <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">Configuración Base</h6>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Costo General ($)</label>
                                            <input type="number" step="0.01" name="Costo_Entrada" id="txtCostoTotal" class="form-control mb-2" value="@costo" @(tienePagos ? "readonly" : "") />
                                            
                                            <div class="form-check form-switch mt-1 p-2 bg-light rounded border border-light">
                                                <input class="form-check-input ms-0 me-2" type="checkbox" id="chkComision" name="Cobrar_Comision_Extra" value="true" @(cobrarComisionExtra ? "checked" : "") style="cursor: pointer;">
                                                <input type="hidden" name="Cobrar_Comision_Extra" value="false" />
                                                <label class="form-check-label small fw-bold text-muted" for="chkComision" style="cursor: pointer;" data-bs-toggle="tooltip" title="Si se desactiva, la organización absorberá los gastos de gestión de Stripe para este evento.">
                                                    Cobrar comisión extra
                                                </label>
                                            </div>
                                            <div class="form-text small mt-1">Precio base. Requerido para calcular porcentajes.</div>
                                        </div>
                                        <div class="col-md-4"><label class="form-label small fw-bold">Cupo Global</label><input type="number" name="Cupo_Maximo" class="form-control" value="@cupo" /><div class="form-text small">0 = Ilimitado.</div></div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Modo Registro</label>
                                            <select name="Tipo_Registro" class="form-select">
                                                <!option value="1" @(tipoRegistro == 1 ? "selected" : "")>Individual</!option>
                                                <!option value="2" @(tipoRegistro == 2 ? "selected" : "")>Grupal (Líder inscribe)</!option>
                                            </select>
                                        </div>
                                    </div>

                                    <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">Modalidades / Subtipos (Opcional)</h6>
                                    <div class="mb-4">
                                        <div class="alert alert-info py-2 small"><i class="fa-solid fa-circle-info me-2"></i> Opciones específicas. Si tienen inscritos, no se pueden borrar ni cambiar costo.</div>
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light small"><tr><th>Nombre Modalidad</th><th width="120">Costo ($)</th><th width="100">Cupo</th><th width="50"></th></tr></thead>
                                            <tbody id="tbodySubtipos">
                                                @for (int i = 0; i < subtipos.Count; i++)
                                                {
                                                    bool bloqueado = subtipos[i].Ocupados > 0;
                                                    string readOnly = bloqueado ? "readonly" : "";
                                                    string classBloq = bloqueado ? "bg-light text-muted" : "";
                                                    <tr class="fila-subtipo">
                                                        <td>
                                                            <input type="hidden" name="Subtipos[@i].Id_Subtipo" value="@subtipos[i].Id_Subtipo" />
                                                            <input type="hidden" name="Subtipos[@i].Activo" value="true" class="inp-act-sub" />
                                                            <input type="text" name="Subtipos[@i].Nombre" class="form-control form-control-sm @classBloq" value="@subtipos[i].Nombre" required @readOnly />
                                                        </td>
                                                        <td><input type="number" step="0.01" name="Subtipos[@i].Costo" class="form-control form-control-sm @classBloq" value="@subtipos[i].Costo" required @readOnly /></td>
                                                        <td><input type="number" name="Subtipos[@i].Cupo" class="form-control form-control-sm" value="@subtipos[i].Cupo" required /></td>
                                                        <td class="text-center">
                                                            @if (bloqueado)
                                                            {
                                                                <span class="text-muted" title="Tiene inscritos"><i class="fa-solid fa-lock"></i></span>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this, '.inp-act-sub')"><i class="fa-solid fa-trash"></i></button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <button type="button" class="btn btn-sm btn-secondary" onclick="agregarSubtipo()"><i class="fa-solid fa-plus me-1"></i> Agregar Modalidad</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary ms-2" onclick="abrirModalLote()"><i class="fa-solid fa-layer-group me-1"></i> Crear en Lote</button>
                                    </div>

                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="chkPago" name="Permitir_Pago" value="true" @(permitirPago ? "checked" : "") onchange="toggleParciales()">
                                        <input type="hidden" name="Permitir_Pago" value="false" />
                                        <label class="form-check-label fw-bold" for="chkPago">Habilitar Recepción de Pagos</label>
                                    </div>

                                    <div id="panelBancario" style="display:none;" class="p-4 bg-white rounded-4 shadow-sm border mb-4 fade-in">
                                        <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">
                                            <i class="fa-solid fa-credit-card me-2"></i> Métodos de Pago Habilitados
                                        </h6>

                                        <div class="row g-3 mb-4">
                                            <div class="col-md-6">
                                                <div class="p-3 border rounded-3 bg-light h-100 transition-hover">
                                                    <div class="form-check form-switch mb-2 d-flex align-items-center">
                                                        <input class="form-check-input me-2" type="checkbox" id="chkTarjeta" name="Permitir_Pago_Tarjeta" value="true" @(permitirPagoTarjeta ? "checked" : "") style="transform: scale(1.3); cursor: pointer;">
                                                        <input type="hidden" name="Permitir_Pago_Tarjeta" value="false" />
                                                        <label class="form-check-label fw-bold" for="chkTarjeta" style="cursor: pointer;">
                                                            <i class="fa-brands fa-stripe text-indigo fs-5 me-1" style="color: #635bff; vertical-align: middle;"></i> Tarjeta de Crédito/Débito
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="p-3 border rounded-3 bg-light h-100 transition-hover">
                                                    <div class="form-check form-switch mb-2 d-flex align-items-center">
                                                        <input class="form-check-input me-2" type="checkbox" id="chkTransferencia" name="Permitir_Transferencia" value="true" @(permitirTransferencia ? "checked" : "") onchange="toggleBanco()" style="transform: scale(1.3);
 cursor: pointer;">
                                                        <input type="hidden" name="Permitir_Transferencia" value="false" />
                                                        <label class="form-check-label fw-bold" for="chkTransferencia" style="cursor: pointer;">
                                                            <i class="fa-solid fa-building-columns text-secondary me-1"></i> Transferencia Bancaria
                                                        </label>
                                                    </div>
                                                    <div id="divSelectBanco" style="display:none;" class="mt-3 pt-3 border-top border-secondary border-opacity-25 ms-2">
                                                        <label class="form-label small fw-bold text-muted mb-1"><i class="fa-solid fa-arrow-turn-down me-1"></i> Cuenta receptora destino</label>
                                                        <select name="Clave_Cuenta_Bancaria" class="form-select form-select-sm border-secondary shadow-sm" id="cboCuentaBancariaDefault">
                                                            @foreach (var b in listaBancos)
                                                            {
                                                                <!option value="@b.Key" @(b.Key == claveCuenta ? "selected" : "")>@b.Value</!option>
                                                            }
                                                        </select>
                                                    </div>
                                                 </div>
                                            </div>
                                        </div>

                                        <div class="form-check form-switch mb-3 mt-3">
                                            <input class="form-check-input" type="checkbox" id="chkUsaCuentaPersonalizada" name="Usa_Cuenta_Personalizada" value="true" @(ViewBag.Usa_Cuenta_Personalizada == true ? "checked" : "") onchange="toggleCuentaPersonalizada()">
                                            <input type="hidden" name="Usa_Cuenta_Personalizada" value="false" />
                                            <label class="form-check-label fw-bold text-danger" for="chkUsaCuentaPersonalizada"><i class="fa-solid fa-building-columns me-1"></i> Usar Cuenta Bancaria Personalizada</label>
                                        </div>

                                        <div id="divCuentaPersonalizada" style="display:none;" class="p-4 border rounded border-warning bg-warning bg-opacity-10 mb-3 rounded-4 shadow-sm">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Banco *</label>
                                                    <input type="text" name="Banco_Custom" id="txtBancoCustom" class="form-control form-control-sm" value="@ViewBag.Banco_Custom" placeholder="Ej. BBVA" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Titular de la Cuenta *</label>
                                                    <input type="text" name="Titular_Custom" id="txtTitularCustom" class="form-control form-control-sm" value="@ViewBag.Titular_Custom" placeholder="Nombre completo" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">CLABE Interbancaria (18 dígitos) *</label>
                                                    <input type="text" name="Clabe_Custom" id="txtClabeCustom" class="form-control form-control-sm font-monospace" value="@ViewBag.Clabe_Custom" maxlength="18" placeholder="012..." />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Número de Cuenta *</label>
                                                    <input type="text" name="Cuenta_Custom" id="txtCuentaCustom" class="form-control form-control-sm font-monospace" value="@ViewBag.Cuenta_Custom" placeholder="Cuenta" />
                                                </div>
                                            </div>
                                        </div>

                                        <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2 mt-2">
                                            <i class="fa-solid fa-calendar-days me-2"></i> Esquema de Cobro
                                        </h6>

                                        <div class="p-3 border rounded-3 bg-light mb-3">
                                            <div class="form-check form-switch mb-0 d-flex align-items-center">
                                                <input class="form-check-input me-2" type="checkbox" id="chkParciales" name="Permitir_Pagos_Parciales" value="true" @(permitirParciales ? "checked" : "") onchange="toggleTablaParciales()" style="transform: scale(1.3); cursor: pointer;">
                                                <input type="hidden" name="Permitir_Pagos_Parciales" value="false" />
                                                <label class="form-check-label fw-bold" for="chkParciales" style="cursor: pointer;">
                                                    Activar Pagos en Parcialidades (Plazos)
                                                </label>
                                            </div>
                                        </div>

                                        <div id="contenedorTablaPagos" style="display:none;" class="p-4 border rounded-3 bg-white shadow-sm mt-3">
                                            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark">Calendario Base</h6>
                                                    <small class="text-muted">Distribución automática según el Costo General.</small>
                                                </div>
                                                <div class="input-group input-group-sm shadow-sm" style="max-width: 300px;">
                                                    <span class="input-group-text bg-light fw-bold text-dark">Dividir en</span>
                                                    <input type="number" id="txtNumPagosAuto" class="form-control text-center fw-bold" value="2" min="2" max="12">
                                                    <span class="input-group-text bg-light text-dark">pagos</span>
                                                    <button type="button" class="btn btn-primary fw-bold px-3" onclick="generarCalendarioAuto()"><i class="fa-solid fa-wand-magic-sparkles"></i> Generar</button>
                                                </div>
                                            </div>
        
                                            <div class="table-responsive rounded border mb-2">
                                                <table class="table table-sm table-hover table-borderless align-middle mb-0">
                                                    <thead class="table-light border-bottom">
                                                        <tr>
                                                            <th width="50" class="text-center text-muted">#</th>
                                                            <th>Fecha Límite</th>
                                                            <th>Monto Base ($)</th>
                                                            <th width="50" class="text-center"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbodyPagos">
                                                        @for (int i = 0; i < calendario.Count; i++)
                                                        {
                                                            <tr class="fila-pago border-bottom">
                                                                <td class="text-center fw-bold num-pago text-secondary">@(i + 1)</td>
                                                                <td>
                                                                    <input type="hidden" name="CalendarioPagos[@i].Id_Calendario_Pago" value="@calendario[i].Id_Calendario_Pago" />
                                                                    <input type="hidden" name="CalendarioPagos[@i].Eliminado" value="false" class="inp-del-pago" />
                                                                    <input type="hidden" name="CalendarioPagos[@i].Numero_Pago" value="@calendario[i].Numero_Pago" class="inp-num-pago" />
                                                                    <input type="datetime-local" name="CalendarioPagos[@i].Fecha_Limite" class="form-control form-control-sm inp-fecha shadow-none" value="@calendario[i].Fecha_Limite.ToString("yyyy-MM-ddTHH:mm")" required />
                                                                </td>
                                                                <td>
                                                                    <div class="input-group input-group-sm">
                                                                        <span class="input-group-text bg-white text-muted border-end-0"><i class="fa-solid fa-dollar-sign"></i></span>
                                                                        <input type="number" step="0.01" name="CalendarioPagos[@i].Monto" class="form-control form-control-sm inp-monto border-start-0 ps-0 shadow-none" value="@calendario[i].Monto" required />
                                                                    </div>
                                                                </td>
                                                                <td class="text-center">
                                                                    <button type="button" class="btn btn-outline-danger btn-sm border-0 bg-light" onclick="eliminarFila(this, '.inp-del-pago')"><i class="fa-solid fa-trash"></i></button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-secondary fw-bold rounded-pill px-3 mt-2" onclick="agregarPago()">
                                                <i class="fa-solid fa-plus me-1"></i> Agregar Pago Manual
                                            </button>
                                        </div>
                                    </div>

                                    <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">Preguntas del Formulario</h6>
                                    <div id="contenedorPreguntas">
                                        @for (int i = 0; i < preguntas.Count; i++)
                                        {
                                            var p = preguntas[i];
                                            <div class="card p-2 mb-2 border-light bg-light fila-pregunta">
                                                <input type="hidden" name="Preguntas[@i].Id_Pregunta" value="@p.Id_Pregunta" />
                                                <input type="hidden" name="Preguntas[@i].Eliminada" value="false" class="inp-eliminada" />
                                                <div class="row g-2 align-items-center">
                                                    <div class="col-md-3">
                                                        <select name="Preguntas[@i].Tipo" class="form-select form-select-sm sel-tipo-preg" onchange="toggleOpciones(this)">
                                                            <!option value="1" @(p.Tipo == TipoPregunta.Texto ? "selected" : "")>Texto Libre</!option>
                                                            <!option value="2" @(p.Tipo == TipoPregunta.Booleano ? "selected" : "")>Sí / No</!option>
                                                            <!option value="3" @(p.Tipo == TipoPregunta.OpcionMultiple ? "selected" : "")>Opción Múltiple</!option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="text" name="Preguntas[@i].Texto" value="@p.Texto" class="form-control form-control-sm mb-1" placeholder="¿Pregunta?" required />
                                                        <input type="text" name="Preguntas[@i].Opciones" value="@p.Opciones" class="form-control form-control-sm bg-white inp-opciones" placeholder="Opciones separadas por |" style="display: @(p.Tipo == TipoPregunta.OpcionMultiple ? "block" : "none");" />
                                                    </div>
                                                    <div class="col-md-1 text-end"><button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this, '.inp-eliminada')"><i class="fa-solid fa-trash"></i></button></div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-dark mt-2" onclick="agregarPregunta()"><i class="fa-solid fa-plus me-1"></i> Nueva Pregunta</button>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="panel-adicionales">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold m-0"><i class="fa-solid fa-cart-plus me-2 text-primary"></i>Productos y Servicios Adicionales</h5>
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm" onclick="agregarProductoExtra()"><i class="fa-solid fa-plus me-1"></i> Agregar Producto</button>
                                </div>
                                <p class="text-muted small">Ofrece extras como cenas, playeras, o desayunos. Estos se cobrarán junto con la inscripción.</p>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm align-middle bg-white mb-0 text-center" style="font-size:0.85rem;">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="text-start">Nombre del Producto / Concepto</th>
                                                <th>Costo</th>
                                                <th>Min</th>
                                                <th>Max</th>
                                                <th>Aplicar a Modalidad</th>
                                                <th style="width:40px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyProductosExtra">
                                            @if (ViewBag.ProductosExtra != null)
                                            {
                                                int idxExtra = 0;
                                                foreach (var ext in ViewBag.ProductosExtra)
                                                {
                                                    var vis = ext.Activo ? "" : "display:none;";
                                                    <tr class="fila-extra" style="@vis">
                                                        <td class="text-start">
                                                            <input type="hidden" name="ProductosExtra[@idxExtra].Id_ProductoExtra" value="@ext.Id_ProductoExtra" />
                                                            <input type="hidden" name="ProductosExtra[@idxExtra].Activo" value="@(ext.Activo ? "true" : "false")" class="inp-act-ext" />
                                                            <input type="text" name="ProductosExtra[@idxExtra].Nombre_Producto" class="form-control form-control-sm mb-1" value="@ext.Nombre_Producto" required />
                                                            <input type="text" name="ProductosExtra[@idxExtra].Descripcion" class="form-control form-control-sm text-secondary" placeholder="Descripci&oacute;n breve (Opcional)" value="@ext.Descripcion" />
                                                        </td>
                                                        <td><input type="number" step="0.01" name="ProductosExtra[@idxExtra].Precio" class="form-control form-control-sm" value="@ext.Precio" required /></td>
                                                        <td><input type="number" name="ProductosExtra[@idxExtra].Cantidad_Minima" class="form-control form-control-sm" value="@ext.Cantidad_Minima" required /></td>
                                                        <td><input type="number" name="ProductosExtra[@idxExtra].Cantidad_Maxima" class="form-control form-control-sm" value="@ext.Cantidad_Maxima" required /></td>
                                                        <td>
                                                            <select name="ProductosExtra[@idxExtra].Id_Subtipo" class="form-select form-select-sm">
                                                                <option value="">Todas (Universal)</option>
                                                                @if (ViewBag.Subtipos != null)
                                                                {
                                                                    foreach (var sub in ViewBag.Subtipos)
                                                                    {
                                                                        var sel = ext.Id_Subtipo == sub.Id_Subtipo ? "selected" : "";
                                                                        <option value="@sub.Id_Subtipo" @sel>@sub.Nombre</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </td>
                                                        <td><button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this, '.inp-act-ext')"><i class="fa-solid fa-trash"></i></button></td>
                                                    </tr>
                                                    idxExtra++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="panel-media">
                                <div class="alert alert-secondary small"><i class="fa-solid fa-cloud-arrow-up me-1"></i> Las imágenes se optimizarán y subirán a la nube automáticamente.</div>
                                @if (galeria.Any())
                                {
                                    <h6 class="fw-bold mb-3 border-bottom pb-2">Imágenes Actuales <span class="small text-muted fw-normal">(Arrastra para reordenar)</span></h6>
                                    <div class="row g-3 mb-5" id="contenedorFotosExistentes">
                                        @for (int i = 0; i < galeria.Count; i++)
                                        {
                                            var foto = galeria[i];
                                            <div class="col-md-3 col-6 card-existente" draggable="true">
                                                <div class="card h-100 shadow-sm border-secondary" style="cursor: grab;">
                                                    <div class="position-absolute top-0 start-0 m-1">
                                                        <span class="badge bg-secondary rounded-circle"><i class="fa-solid fa-arrows-up-down-left-right"></i></span>
                                                    </div>
                                                    <img src="@foto.Url_Foto" class="card-img-top" style="height: 120px; object-fit: cover;">
                                                    <div class="card-body p-2 text-center bg-light" style="cursor: default;">
                                                        <input type="hidden" name="Galeria[@i].Id_Foto" value="@foto.Id_Foto" class="input-id-foto" />
                                                        <input type="text" name="Galeria[@i].Descripcion" value="@foto.Descripcion" class="form-control form-control-sm mb-2 border-primary input-desc-foto" placeholder="Descripción (opcional)" />
                                                        <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="marcarEliminarFoto(this, '@foto.Url_Foto')">
                                                            <i class="fa-solid fa-trash me-1"></i> Eliminar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                <h6 class="fw-bold mb-3 border-bottom pb-2 mt-5">Agregar Nuevas Imágenes</h6>
                                <div class="mb-4">
                                    <input type="file" id="inputGaleriaNuevas" name="nuevasFotosGaleria" accept=".jpg,.jpeg,.png,.webp" multiple style="display: none;" />
                                    <div id="dropzoneGaleria" class="border rounded p-4 text-center bg-light" style="cursor: pointer; border: 2px dashed #ccc !important; transition: all 0.3s;">
                                        <i class="fa-solid fa-cloud-arrow-up fa-3x text-secondary mb-2"></i>
                                        <h6 class="text-dark fw-bold">Haz clic aquí o arrastra tus imágenes</h6>
                                        <p class="mb-0 text-muted small">Formatos: JPG, PNG, WEBP. (Max 10MB por foto)</p>
                                    </div>
                                    <div id="previewNuevasFotos" class="row g-3 mt-3"></div>
                                </div>
                                <div id="contenedorImagenesAEliminar"></div>
                            </div>

                            <div class="tab-pane fade" id="panel-avanzado">
                                
                                <div class="mb-4 p-3 bg-white border rounded shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-clipboard-question text-primary me-2"></i>Encuesta como Requisito (Obligatoria)</h5>
                                    </div>
                                    <p class="small text-muted mb-3">Si seleccionas una encuesta, se requerirá responderla por cada asistente registrado para habilitar sus comprobantes y códigos QR de acceso. Solo se listan encuestas configuradas con <strong>"Requiere Inicio de Sesión"</strong>.</p>
                                    
                                    <div class="mb-3">
                                        <select class="form-select border-primary" id="cboEncuestaRequisito" name="Id_Encuesta_Requisito">
                                            <option value="0">-- Ninguna (No requerida) --</option>
                                            @foreach (var enc in encuestasReq)
                                            {
                                                <!option value="@enc.Id" @(enc.Id == idEncuestaSeleccionada ? "selected" : "")>@enc.Titulo</!option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-4 p-3 bg-white border rounded shadow-sm transition-hover">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="form-check form-switch me-3 mb-0">
                                            <input class="form-check-input" type="checkbox" id="Es_Privado" name="Es_Privado" value="true" @(esPrivado ? "checked" : "") onchange="toggleWhitelist()" style="transform: scale(1.5); cursor: pointer; border-color: #0d6efd; background-color: @(esPrivado ? "#0d6efd" : "#e9ecef");">
                                            <input type="hidden" name="Es_Privado" value="false" />
                                        </div>
                                        <div class="flex-grow-1">
                                            <h5 class="fw-bold mb-0 d-flex align-items-center" id="lblPrivacidadTitulo">
                                                <i class="fa-solid fa-lock text-primary me-2" id="iconoPrivacidad"></i>
                                                <span id="textoPrivacidad" class="text-primary">Acceso Privado</span>
                                            </h5>
                                        </div>
                                    </div>
                                    <div class="border rounded p-3 bg-light shadow-sm" id="boxPrivacidadInfo">
                                        <div class="d-flex align-items-center mb-2" id="hintPrivado">
                                            <i class="fa-solid fa-check text-success me-2"></i>
                                            <span class="fw-bold text-dark">El Evento NO SERÁ VISIBLE para Todos</span>
                                        </div>
                                        <div class="d-flex align-items-center" id="hintPublico">
                                            <i class="fa-solid fa-xmark text-danger opacity-50 me-2"></i>
                                            <span class="text-muted text-decoration-line-through">Cualquier usuario registrado PODRÁ VER el Evento.</span>
                                        </div>
                                    </div>
                                </div>

                                <div id="panelWhitelist" style="display:none;" class="fade-in">
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <div class="card h-100 border-primary border-opacity-25 bg-primary bg-opacity-10">
                                                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                                                    <h6 class="fw-bold text-primary mb-0"><i class="fa-solid fa-users-rectangle me-2"></i>A. Acceso por Grupo</h6>
                                                </div>
                                                <div class="card-body">
                                                    <p class="small text-muted mb-3">Todos los usuarios vinculados al grupo seleccionado tendrán acceso automático.</p>
                                                    <div class="mb-3">
                                                        <label for="cboGrupo" class="form-label small fw-bold text-muted mb-1">Seleccionar Grupo de Usuarios</label>
                                                        <select class="form-select border-primary" id="cboGrupo" name="Id_Grupo_Usuarios" style="width: 100%;">
                                                            <option value="0">-- Ninguno (Solo lista individual) --</option>
                                                            @foreach (var g in gruposDisponibles)
                                                            {
                                                                <!option value="@g.Id" @(g.Id == idGrupoSeleccionado ? "selected" : "")>@g.Nombre</!option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="mt-2 small text-primary">
                                                        <i class="fa-solid fa-circle-info me-1"></i> Útil para "Líderes", "Ventas", etc.
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card h-100 border-secondary border-opacity-25">
                                                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                                                    <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-user-plus me-2"></i>B. Lista Individual</h6>
                                                </div>
                                                <div class="card-body">
                                                    <p class="small text-muted mb-3">Agrega usuarios específicos adicionales (aunque no estén en el grupo).</p>
                                                    <div class="input-group mb-2">
                                                        <select class="form-select" id="cboUsuarios">
                                                            <option value="">- Buscar Usuario -</option>
                                                            @foreach (dynamic u in todosUsuarios)
                                                            {
                                                                <!option value="@u.Id" data-verificado="@u.Verificado.ToString().ToLower()">
                                                                    @u.Nombre @(u.Verificado ? "✅" : "⚠️")
                                                                </!option>
                                                            }
                                                        </select>
                                                        <button type="button" class="btn btn-secondary" onclick="agregarInscriptor()">
                                                            <i class="fa-solid fa-plus"></i>
                                                        </button>
                                                    </div>
                                                    <div class="border rounded bg-white p-0 overflow-auto" style="max-height: 150px;">
                                                        <input type="hidden" name="IdsInscriptores" id="hdnIdsInscriptores" value="@idsInscriptoresStr" />
                                                        <ul class="list-group list-group-flush" id="listaInscriptores">
                                                            @{
                                                                var hist = ViewBag.InscriptoresConHistorial as List<int> ?? new List<int>();
                                                            }
                                                            @foreach (var ins in inscriptores)
                                                            {
                                                                bool locked = hist.Contains(ins.Id_Usuario);
                                                                <li class="list-group-item d-flex justify-content-between align-items-center item-whitelist py-2" data-id="@ins.Id_Usuario">
                                                                    <span class="small fw-bold text-truncate" style="max-width: 80%;">
                                                                        <i class="fa-solid fa-user-check me-2 text-success"></i>@ins.NombreUsuario
                                                                    </span>
                                                                    @if (locked)
                                                                    {
                                                                        <span class="badge bg-light text-muted border"><i class="fa-solid fa-lock"></i></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-sm text-danger p-0" onclick="removerInscriptor(@ins.Id_Usuario)">
                                                                            <i class="fa-solid fa-xmark"></i>
                                                                        </button>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 mt-4">
                                            <div class="card border-info bg-info bg-opacity-10 rounded-4">
                                                <div class="card-header bg-transparent border-0 pt-3">
                                                    <h6 class="fw-bold text-info mb-0"><i class="fa-solid fa-link me-2"></i>C. Validación por Evento Previo</h6>
                                                </div>
                                                <div class="card-body">
                                                    <p class="small text-muted mb-3">Requiere que el usuario esté inscrito y tenga <strong>al menos un pago aprobado</strong> en el evento seleccionado.</p>
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-bold text-dark">1. Seleccionar Evento Origen</label>
                                                            <select class="form-select" id="cboEventoVinculado" name="Id_Evento_Vinculado" onchange="cargarModalidadesVinculadas(this.value)">
                                                                <option value="0">-- Ninguno (Sin dependencia) --</option>
                                                                @foreach (var e in eventosVinculables)
                                                                {
                                                                    <!option value="@e.Id" @(e.Id == idEventoVinculado ? "selected" : "")>@e.Titulo @(!e.Activo ? "(Pasado/Inactivo)" : "")</!option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-bold text-dark">2. Modalidades Válidas (Opcional)</label>
                                                            <div id="cntModalidadesVinculadas" class="p-3 bg-white border rounded shadow-sm" style="max-height: 150px; overflow-y: auto;">
                                                                <span class="text-muted small">Selecciona un evento para ver modalidades.</span>
                                                            </div>
                                                            <input type="hidden" name="Subtipos_Vinculados_Acceso" id="hdnSubVinculados" value="@subtiposVinculados" />
                                                            <div class="form-text small">Si no marcas ninguna, cualquier persona del evento origen con pago podrá acceder.</div>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="alert alert-warning mt-3 small mb-0">
                                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                                        <strong>Nota:</strong> El acceso se concede si el usuario cumple con <strong>CUALQUIERA</strong> de las condiciones habilitadas (Grupo O Lista Individual O Evento Previo).
                                    </div>
                                </div>

                                <h6 class="text-success fw-bold text-uppercase small mb-3 border-bottom pb-2 mt-5">Opciones de Publicación</h6>
                                <div class="d-flex gap-4 flex-wrap">
                                    <div class="form-check form-switch p-2 border rounded bg-light pe-4">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="Es_Destacado" name="Es_Destacado" value="true" @(esDestacado ? "checked" : "")>
                                        <input type="hidden" name="Es_Destacado" value="false" />
                                        <label class="form-check-label fw-bold" for="Es_Destacado">Destacar en Inicio</label>
                                    </div>
                                    <div class="form-check form-switch p-2 border rounded bg-light pe-4">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="Activo" name="Activo" value="true" @(activo ? "checked" : "")>
                                        <input type="hidden" name="Activo" value="false" />
                                        <label class="form-check-label fw-bold" for="Activo">Evento Público / Activo</label>
                                    </div>
                                    <div class="form-check form-switch p-2 border rounded bg-danger bg-opacity-10 border-danger pe-4">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="Bloqueado" name="Bloqueado" value="true" @((ViewBag.Bloqueado != null && (bool)ViewBag.Bloqueado) ? "checked" : "") style="cursor:pointer;">
                                        <input type="hidden" name="Bloqueado" value="false" />
                                        <label class="form-check-label fw-bold text-danger" for="Bloqueado">Bloquear Evento</label>
                                        <div class="form-text small mt-1 text-dark">Impide nuevos registros, edición de datos y cancelaciones. Solo permite pagar deudas.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top p-4">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow hover-scale"><i class="fa-solid fa-save me-2"></i> Guardar Todo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="tplSubtipo">
    <tr class="fila-subtipo">
        <td><input type="hidden" name="Subtipos[IDX].Id_Subtipo" value="0" disabled /><input type="hidden" name="Subtipos[IDX].Activo" value="true" class="inp-act-sub" disabled /><input type="text" name="Subtipos[IDX].Nombre" class="form-control form-control-sm" placeholder="Ej. Cabaña" required disabled /></td>
        <td><input type="number" step="0.01" name="Subtipos[IDX].Costo" class="form-control form-control-sm" required disabled /></td>
        <td><input type="number" name="Subtipos[IDX].Cupo" class="form-control form-control-sm" required disabled /></td>
        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this, '.inp-act-sub')"><i class="fa-solid fa-trash"></i></button></td>
    </tr>
</template>

<template id="tplProductoExtra">
    <tr class="fila-extra">
        <td class="text-start">
            <input type="hidden" name="ProductosExtra[IDX].Id_ProductoExtra" value="0" disabled />
            <input type="hidden" name="ProductosExtra[IDX].Activo" value="true" class="inp-act-ext" disabled />
            <input type="text" name="ProductosExtra[IDX].Nombre_Producto" class="form-control form-control-sm mb-1" placeholder="Ej. Cena de Gala" required disabled />
            <input type="text" name="ProductosExtra[IDX].Descripcion" class="form-control form-control-sm text-secondary" placeholder="Descripci&oacute;n breve (Opcional)" disabled />
        </td>
        <td><input type="number" step="0.01" name="ProductosExtra[IDX].Precio" class="form-control form-control-sm" value="0" required disabled /></td>
        <td><input type="number" name="ProductosExtra[IDX].Cantidad_Minima" class="form-control form-control-sm" value="0" required disabled /></td>
        <td><input type="number" name="ProductosExtra[IDX].Cantidad_Maxima" class="form-control form-control-sm" value="1" required disabled /></td>
        <td>
            <select name="ProductosExtra[IDX].Id_Subtipo" class="form-select form-select-sm" disabled>
                <option value="">Todas (Universal)</option>
                @if (ViewBag.Subtipos != null)
                {
                    foreach (var sub in ViewBag.Subtipos)
