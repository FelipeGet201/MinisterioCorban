@section Scripts {
    <script src="~/lib/select2/select2.min.js"></script>

    <script>
        $(document).ready(function() {
        $('#cboUsuarios').select2({
            placeholder: "- Buscar Usuario -",
            allowClear: true,
            language: {
                noResults: function() { return "No se encontraron usuarios"; }
            }
        });
        $('#cboGrupo, #cboEventoVinculado').select2({
            width: '100%' 
        });

        const idVinculadoInicial = parseInt($('#cboEventoVinculado').val());
        if(idVinculadoInicial > 0) { 
            cargarModalidadesVinculadas(idVinculadoInicial, "@subtiposVinculados"); 
        }

        let formCambiado = false;
        const btnGrafico = document.getElementById('btnEditorGrafico');
        const alertaCambios = document.getElementById('alertaCambiosImagen');
        const filePortada = document.getElementById('filePortada');
        if(btnGrafico) {
            document.getElementById('formEditor').addEventListener('change', () => {
                formCambiado = true;
                btnGrafico.classList.add('disabled', 'opacity-50');
                btnGrafico.style.pointerEvents = 'none';
                if(alertaCambios) alertaCambios.classList.remove('d-none');
            });
            if(filePortada && filePortada.files.length > 0) {
                btnGrafico.classList.add('disabled', 'opacity-50');
                btnGrafico.style.pointerEvents = 'none';
            }
        }
        });

        function cargarModalidadesVinculadas(id, seleccionados = "") {
            const container = $('#cntModalidadesVinculadas');
            const hdn = $('#hdnSubVinculados');
            if(id == 0) {
                container.html('<span class="text-muted small">Selecciona un evento para ver modalidades.</span>');
                hdn.val("");
                return;
            }

            container.html('<div class="text-center py-2"><i class="fa-solid fa-spinner fa-spin text-info"></i></div>');
            $.get("@Url.Action("GetSubtiposEvento")", { idEvento: id }, function(res) {
                if(res && res.length > 0) {
                    let html = '<div class="row">';
                    const arraySeleccionados = seleccionados.split(',');
                    res.forEach(m => {
                        const checked = arraySeleccionados.includes(m.id.toString()) ? "checked" : "";
                        html += `<div class="col-12"><div class="form-check">
                        <input class="form-check-input chk-sub-vinc" type="checkbox" value="${m.id}" id="sv_${m.id}" ${checked} onchange="actualizarSubVinculados()">
                        <label class="form-check-label small" for="sv_${m.id}">${m.nombre}</label>
                        </div></div>`;
                    });
                    html += '</div>';
                    container.html(html);
                } else {
                    container.html('<span class="text-info small"><i class="fa-solid fa-circle-info me-1"></i> Este evento no tiene modalidades. Cualquier inscrito con pago podrá acceder.</span>');
                    hdn.val("");
                }
            });
        }

        function actualizarSubVinculados() {
            const seleccionados = $('.chk-sub-vinc:checked').map(function() { return this.value; }).get();
            $('#hdnSubVinculados').val(seleccionados.join(','));
        }
    </script>
}
<script>
    function toggleRegistro() {
        var chk = document.getElementById('chkRegistro');
        var panel = document.getElementById('panelRegistroContent');
        if (panel) { panel.style.display = chk.checked ? 'block' : 'none'; }
        toggleParciales();
    }

    function toggleParciales() {
        var chkPago = document.getElementById('chkPago');
        var panel = document.getElementById('panelBancario');
        if (panel) { panel.style.display = chkPago.checked ? 'block' : 'none'; }
        toggleTablaParciales(); 
        toggleBanco();
    }

    function toggleBanco() {
        var chk = document.getElementById('chkTransferencia');
        var div = document.getElementById('divSelectBanco');
        if (chk && div) { div.style.display = chk.checked ? 'block' : 'none'; }
    }

    function toggleTablaParciales() {
        var chk = document.getElementById('chkParciales');
        var pago = document.getElementById('chkPago');
        var tabla = document.getElementById('contenedorTablaPagos');
        if (tabla) { tabla.style.display = (chk.checked && pago.checked) ? 'block' : 'none'; }
    }

    function toggleOpciones(select) {
        var row = select.closest('.row');
        var inp = row.querySelector('.inp-opciones');
        if (inp) { inp.style.display = (select.value == '3') ? 'block' : 'none'; }
    }

    function toggleWhitelist() {
        var chk = document.getElementById('Es_Privado');
        var panel = document.getElementById('panelWhitelist');
        if (panel) { panel.style.display = chk.checked ? 'block' : 'none'; }

        var icono = document.getElementById('iconoPrivacidad');
        var texto = document.getElementById('textoPrivacidad');
        var hintPrivado = document.getElementById('hintPrivado');
        var hintPublico = document.getElementById('hintPublico');
        if(chk && icono && texto && hintPrivado && hintPublico) {
            if (chk.checked) {
                icono.className = 'fa-solid fa-lock text-primary me-2';
                texto.innerText = 'Acceso Privado'; 
                texto.className = 'text-primary';

                hintPrivado.innerHTML = '<i class="fa-solid fa-check text-success me-2"></i> <span class="fw-bold text-dark">El Evento NO SERÁ VISIBLE para Todos</span>';
                hintPublico.innerHTML = '<i class="fa-solid fa-xmark text-danger opacity-50 me-2"></i> <span class="text-muted text-decoration-line-through">Cualquier usuario registrado PODRÁ VER el Evento.</span>';
                chk.style.backgroundColor = '#0d6efd'; 
                chk.style.borderColor = '#0d6efd';
            } else {
                icono.className = 'fa-solid fa-globe text-success me-2';
                texto.innerText = 'Acceso Público'; 
                texto.className = 'text-success';

                hintPrivado.innerHTML = '<i class="fa-solid fa-xmark text-danger opacity-50 me-2"></i> <span class="text-muted text-decoration-line-through">El Evento NO SERÁ VISIBLE para Todos</span>';
                hintPublico.innerHTML = '<i class="fa-solid fa-check text-success me-2"></i> <span class="fw-bold text-dark">Cualquier usuario registrado PODRÁ VER el Evento.</span>';
                chk.style.backgroundColor = '';
                chk.style.borderColor = '';
            }
        }
    }

    var arrInscriptores = [@idsInscriptoresStr];
    var arrBloqueados = [@string.Join(",", (ViewBag.InscriptoresConHistorial as List<int> ?? new List<int>()))];
    
    function agregarInscriptor() {
        var cbo = document.getElementById('cboUsuarios');
        var id = parseInt(cbo.value);
        if (!id) return;
        if (arrInscriptores.includes(id)) return;

        var option = cbo.options[cbo.selectedIndex];
        if (option.getAttribute('data-verificado') === 'false') {
            alert('⛔ NO PERMITIDO: El usuario seleccionado no tiene su correo verificado.');
            return;
        }

        arrInscriptores.push(id);
        actualizarHiddenInscriptores();

        var li = document.createElement('li');
        li.className = 'list-group-item d-flex justify-content-between align-items-center item-whitelist py-2';
        li.setAttribute('data-id', id);
        li.innerHTML = `<span class="small fw-bold text-truncate" style="max-width: 80%;"><i class="fa-solid fa-user-check me-2 text-success"></i>${option.text}</span>
        <button type="button" class="btn btn-sm text-danger p-0" onclick="removerInscriptor(${id})">
            <i class="fa-solid fa-xmark"></i>
            </button>`;
        document.getElementById('listaInscriptores').appendChild(li);
        $('#cboUsuarios').val(null).trigger('change');
    }

    function removerInscriptor(id) {
        if (arrBloqueados.includes(id)) { 
            alert('⚠️ DENEGADO: Este usuario ya tiene historial de registros en este evento.'); 
            return; 
        }
        arrInscriptores = arrInscriptores.filter(x => x !== id);
        actualizarHiddenInscriptores();
        var item = document.querySelector(`.item-whitelist[data-id="${id}"]`);
        if (item) item.remove();
    }

    function actualizarHiddenInscriptores() { 
        document.getElementById('hdnIdsInscriptores').value = arrInscriptores.join(','); 
    }

    function agregarItemGenerico(idContainer, idTemplate, claseItem) {
        var container = document.getElementById(idContainer);
        var template = document.getElementById(idTemplate);
        if (!container || !template) return;

        var index = document.querySelectorAll(claseItem).length;
        var html = template.innerHTML.replace(/IDX/g, index);
        var tempElement;
        if (container.tagName === 'TBODY') {
            tempElement = document.createElement('tbody');
            tempElement.innerHTML = html;
            container.appendChild(tempElement.firstElementChild);
        } else {
            tempElement = document.createElement('div');
            tempElement.innerHTML = html;
            container.appendChild(tempElement.firstElementChild);
        }
        var inputs = container.lastElementChild.querySelectorAll('input, select, textarea, button');
        inputs.forEach(el => el.removeAttribute('disabled'));
    }

    function marcarEliminarFoto(btn, url) {
        var container = document.getElementById('contenedorImagenesAEliminar');
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'imagenesAEliminar';
        input.value = url;
        container.appendChild(input);
        var card = btn.closest('.col-md-3') || btn.closest('.col-6');
        if (card) card.style.display = 'none';
    }

    function agregarSubtipo() { agregarItemGenerico('tbodySubtipos', 'tplSubtipo', '.fila-subtipo'); }
    function agregarProductoExtra() { agregarItemGenerico('tbodyProductosExtra', 'tplProductoExtra', '.fila-extra'); }
    function abrirModalLote() { 
        var modal = new bootstrap.Modal(document.getElementById('modalLoteSubtipos'));
        modal.show(); 
    }

    function generarLoteSubtipos() {
        var formato = document.getElementById('txtLoteFormato').value;
        var cantidad = parseInt(document.getElementById('txtLoteCantidad').value);
        var inicio = parseInt(document.getElementById('txtLoteInicio').value);
        var costo = parseFloat(document.getElementById('txtLoteCosto').value);
        var cupo = parseInt(document.getElementById('txtLoteCupo').value);
        if (!formato.includes('{n}')) { 
            alert("El formato debe incluir el comodín {n} para colocar el número."); 
            return; 
        }
        if (isNaN(cantidad) || cantidad <= 0) return;

        var container = document.getElementById('tbodySubtipos');
        var template = document.getElementById('tplSubtipo');
        for (var i = 0; i < cantidad; i++) {
            var numActual = inicio + i;
            var numStr = numActual < 10 ? "0" + numActual : numActual.toString();
            var nombreFinal = formato.replace(/{n}/g, numStr);
            var index = document.querySelectorAll('.fila-subtipo').length;
            var html = template.innerHTML.replace(/IDX/g, index);
            
            var tempElement = document.createElement('tbody');
            tempElement.innerHTML = html;
            var nuevaFila = tempElement.firstElementChild;
            nuevaFila.querySelector('input[name$=".Nombre"]').value = nombreFinal;
            nuevaFila.querySelector('input[name$=".Costo"]').value = costo;
            nuevaFila.querySelector('input[name$=".Cupo"]').value = cupo;
            
            var inputs = nuevaFila.querySelectorAll('input, select, textarea, button');
            inputs.forEach(el => el.removeAttribute('disabled'));

            container.appendChild(nuevaFila);
        }

        var modal = bootstrap.Modal.getInstance(document.getElementById('modalLoteSubtipos'));
        modal.hide();
    }

    function agregarPregunta() { agregarItemGenerico('contenedorPreguntas', 'tplPregunta', '.fila-pregunta'); }
    function agregarPago() {
        agregarItemGenerico('tbodyPagos', 'tplPago', '.fila-pago');
        renumerarPagos();
    }

    function eliminarFila(btn, selectorBorradoLogico) {
        var fila = btn.closest('.fila-subtipo, .fila-pago, .fila-pregunta, .fila-extra');
        if (!fila) return;

        var inputId = fila.querySelector('input[name*=".Id_"]');
        var esNuevo = (inputId && (inputId.value === "0" || inputId.value === ""));
        if (esNuevo) {
            fila.remove();
        } else {
            var inputOculto = fila.querySelector(selectorBorradoLogico);
            if (inputOculto) {
                fila.style.display = 'none';
                if (selectorBorradoLogico.includes('inp-act-sub') || selectorBorradoLogico.includes('inp-act-ext')) { 
                    inputOculto.value = 'false'; 
                } else {
                    inputOculto.value = 'true';
                }
                inputOculto.removeAttribute('disabled');
                fila.querySelectorAll('input, select, textarea').forEach(el => { 
                    el.removeAttribute('required'); 
                });
            } else {
                fila.remove(); 
            }
        }

        if (typeof renumerarPagos === 'function') renumerarPagos();
    }

    var callbackModalAlerta = null;
    document.getElementById('modalAlertaEvento').addEventListener('hidden.bs.modal', function () {
        if (typeof callbackModalAlerta === 'function') {
            callbackModalAlerta(); 
            callbackModalAlerta = null; 
        }
    });
    function mostrarModalAlerta(titulo, mensaje, callbackAlCerrar) {
        document.getElementById('modalAlertaTitulo').innerHTML = '<i class="fa-solid fa-triangle-exclamation me-2"></i>' + titulo;
        document.getElementById('modalAlertaMensaje').innerHTML = mensaje.replace(/\n/g, '<br>');
        callbackModalAlerta = callbackAlCerrar || null;
        var modal = new bootstrap.Modal(document.getElementById('modalAlertaEvento'));
        modal.show();
    }

    function generarCalendarioAuto() {
        var inputCosto = document.getElementById('txtCostoTotal');
        var inputNum = document.getElementById('txtNumPagosAuto');
        var inputFecha = document.getElementById('txtFechaInicio');

        var costo = parseFloat(inputCosto.value);
        var num = parseInt(inputNum.value);
        var fechaStr = inputFecha.value;
        if (!costo || costo <= 0 || !fechaStr) {
            mostrarModalAlerta(
                "Datos incompletos",
                "Para generar el calendario automático necesitas:\n\n1. Definir un <strong>Costo General</strong> válido.\n2. Definir la <strong>Fecha de Inicio</strong> del evento."
            );
            return;
        }

        var fechaEvento = new Date(fechaStr);
        var fechaHoy = new Date();
        if (fechaEvento <= fechaHoy) {
            mostrarModalAlerta(
                "Fecha inválida", 
                "La fecha de inicio del evento ya pasó o es hoy.\n\nAjusta la configuración a una <strong>fecha futura</strong> para poder calcular las parcialidades correctamente.", 
            function() {
                var tabGeneralBtn = document.querySelector('button[data-bs-target="#panel-general"]');
                if (tabGeneralBtn) { 
                    var tabGeneral = new bootstrap.Tab(tabGeneralBtn);
                    tabGeneral.show();
                }

                setTimeout(function() {
                    inputFecha.setAttribute('title', 'Debe ser en el futuro para calcular parcialidades.');

                    if(typeof inputFecha.setCustomValidity === 'function') { 
                        inputFecha.setCustomValidity('La fecha debe ser en el futuro.'); 
                        inputFecha.reportValidity();
                    }

                    inputFecha.focus();
                    inputFecha.addEventListener('input', function() { 
                        inputFecha.setCustomValidity('');
                        inputFecha.removeAttribute('title');
                    }, { once: true });
                }, 200);
            }
            );
            return;
        }

        var limiteFinal = new Date(fechaEvento);
        limiteFinal.setDate(limiteFinal.getDate() - 30);
        if (limiteFinal < fechaHoy) limiteFinal = new Date(fechaEvento);

        var montoBase = Math.floor(costo / num);
        var resto = costo - (montoBase * (num - 1));
        var tiempoTotal = limiteFinal.getTime() - fechaHoy.getTime();
        var intervalo = (tiempoTotal < 0 ? 0 : tiempoTotal) / Math.max(1, num - 1);
        document.querySelectorAll('.fila-pago').forEach(row => {
            var inpId = row.querySelector('input[name*="Id_Calendario"]');
            if (inpId && inpId.value == "0") { row.remove(); }
            else {
                var inpDel = row.querySelector('.inp-del-pago');
                if (inpDel) { 
                    row.style.display = 'none'; 
                    inpDel.value = 'true';
                    inpDel.removeAttribute('disabled');
                }
            }
        });
        for (var i = 0; i < num; i++) {
            agregarPago();
            var filasVisibles = Array.from(document.querySelectorAll('.fila-pago')).filter(x => x.style.display !== 'none');
            var tr = filasVisibles[filasVisibles.length - 1];
            var monto = (i === num - 1) ? resto : montoBase;
            var fechaCalculada = (i === 0) ?
            fechaHoy : (i === num - 1 ? limiteFinal : new Date(fechaHoy.getTime() + (intervalo * i)));
            var localDate = new Date(fechaCalculada.getTime() - (fechaCalculada.getTimezoneOffset() * 60000));
            tr.querySelector('.inp-monto').value = monto.toFixed(2);
            tr.querySelector('.inp-fecha').value = localDate.toISOString().slice(0, 16);
        }
    }

    function renumerarPagos() {
        var c = 1;
        document.querySelectorAll('.fila-pago').forEach(row => {
            if (row.style.display !== 'none') {
                row.querySelector('.num-pago').innerText = c;
                row.querySelector('.inp-num-pago').value = c;
                c++;
            }
        });
    }

    const dropzone = document.getElementById('dropzoneGaleria');
    const inputGaleria = document.getElementById('inputGaleriaNuevas');
    const previewContainer = document.getElementById('previewNuevasFotos');

    let dt = new DataTransfer();
    let descripcionesMapeo = [];
    if (dropzone && inputGaleria && previewContainer) {
        dropzone.addEventListener('click', () => inputGaleria.click());
        dropzone.addEventListener('dragover', (e) => { 
            e.preventDefault();
            dropzone.classList.add('dragover'); 
        });
        dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
        dropzone.addEventListener('drop', (e) => { 
            e.preventDefault();
            dropzone.classList.remove('dragover'); 
            procesarArchivosNuevos(e.dataTransfer.files); 
        });
        inputGaleria.addEventListener('change', (e) => { 
            procesarArchivosNuevos(e.target.files); 
        });
    }

    function procesarArchivosNuevos(files) {
        for (let i = 0; i < files.length; i++) {
            if (files[i].size > 10 * 1024 * 1024) { 
                alert(`La imagen ${files[i].name} pesa más de 10MB.`); 
                continue;
            }
            dt.items.add(files[i]);
            descripcionesMapeo.push("");
        }
        actualizarInputYRenderizarNuevas();
    }

    function actualizarInputYRenderizarNuevas() { 
inputGaleria.files = dt.files; 
renderizarPreviewsNuevas(); 
    }

    function renderizarPreviewsNuevas() {
        previewContainer.innerHTML = '';
        Array.from(dt.files).forEach((file, index) => {
            let reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = function(e) {
                let col = document.createElement('div');
                col.className = 'col-md-3 col-6 preview-card';
                col.draggable = true;
                col.dataset.index = index;
                col.innerHTML = `
                <div class="card shadow-sm border-success h-100 bg-light">
                <div class="position-absolute top-0 start-0 m-1">
                <span class="badge bg-success rounded-circle"><i class="fa-solid fa-arrows-up-down-left-right"></i></span>
                </div>
                <img src="${e.target.result}" class="preview-img">
                <div
                    class="card-body p-2 text-center">
                <p class="small text-truncate mb-1 text-muted" title="${file.name}">${file.name}</p>
                <input type="text" name="descripcionesNuevasFotos" class="form-control form-control-sm mb-2 border-success inp-desc-dinamico" placeholder="Descripción (Opcional)" value="${descripcionesMapeo[index]}">
                
                <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="eliminarArchivoNuevo(${index})">
                <i class="fa-solid fa-trash me-1"></i> Quitar
                </button>
                </div>

                </div>
                `;
                setTimeout(() => {
                    let textInput = col.querySelector('.inp-desc-dinamico');
                    textInput.addEventListener('input', function(ev) {
                        let currentIndex = parseInt(col.dataset.index);
                        descripcionesMapeo[currentIndex] = ev.target.value;
                    });
                }, 0);
                col.addEventListener('dragstart', handleDragStart);
                col.addEventListener('dragover', handleDragOver);
                col.addEventListener('drop', handleDrop);
                col.addEventListener('dragend', handleDragEnd);

                previewContainer.appendChild(col);
            }
        });
    }

    let dragSrcEl = null;
    function handleDragStart(e) {
        if(e.target.tagName.toLowerCase() === 'input' || e.target.tagName.toLowerCase() === 'button') { 
            e.preventDefault(); 
            return;
        }
        dragSrcEl = this;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(() => this.style.opacity = '0.4', 0);
    }

    function handleDragOver(e) { 
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move'; 
        return false; 
    }

    function handleDrop(e) {
        e.stopPropagation();
        if (dragSrcEl !== null && dragSrcEl !== this) {

            const allCards = Array.from(previewContainer.querySelectorAll('.preview-card'));
            const srcIndexDOM = allCards.indexOf(dragSrcEl);
            const targetIndexDOM = allCards.indexOf(this);

            if (srcIndexDOM < targetIndexDOM) {
                this.parentNode.insertBefore(dragSrcEl, this.nextSibling);
            } else {
                this.parentNode.insertBefore(dragSrcEl, this); 
            }

            let newDt = new DataTransfer();
            let newDescripciones = [];
            const reorderedCards = previewContainer.querySelectorAll('.preview-card');
            reorderedCards.forEach((card, newIndex) => {
                let oldIndex = parseInt(card.dataset.index);
                newDt.items.add(dt.files[oldIndex]);
                newDescripciones.push(descripcionesMapeo[oldIndex]);
                card.dataset.index = newIndex;
                let btn = card.querySelector('button');
                if (btn) btn.setAttribute('onclick', `eliminarArchivoNuevo(${newIndex})`);
            });
            dt = newDt; 
            descripcionesMapeo = newDescripciones;
            inputGaleria.files = dt.files;
        }
        return false;
    }

    function handleDragEnd(e) {
        this.style.opacity = '1'; 
        dragSrcEl = null; 
    }

    window.eliminarArchivoNuevo = function(indexToRemove) {
        let newDt = new DataTransfer();
        let filesArray = Array.from(dt.files);
        filesArray.splice(indexToRemove, 1);
        descripcionesMapeo.splice(indexToRemove, 1);
        filesArray.forEach((file) => newDt.items.add(file));
        dt = newDt;
        actualizarInputYRenderizarNuevas();
    }

    var txtInicio = document.getElementById('txtFechaInicio');
    if (txtInicio) {
        txtInicio.addEventListener('change', function() {
            var valInicio = this.value;
            var txtFin = document.getElementById('txtFechaFin');
            if (valInicio && txtFin) {
                var d = new Date(valInicio);
                d.setHours(d.getHours() + 2);
                var localDate = new Date(d.getTime() - (d.getTimezoneOffset() * 60000));
                txtFin.value = localDate.toISOString().slice(0, 16);
            }
        });
    }

    toggleRegistro();
    if (typeof toggleWhitelist === 'function') toggleWhitelist();
    toggleCuentaPersonalizada();

    function toggleCuentaPersonalizada() {
        var chkCustom = document.getElementById('chkUsaCuentaPersonalizada');
        var divCustom = document.getElementById('divCuentaPersonalizada');
        var chkTarjeta = document.getElementById('chkTarjeta');
        var chkTransferencia = document.getElementById('chkTransferencia');
        var cboDefault = document.getElementById('cboCuentaBancariaDefault');

        if (chkCustom && divCustom) {
            if (chkCustom.checked) {
                divCustom.style.display = 'block';
                if (cboDefault) cboDefault.disabled = true;
                if (chkTarjeta) {
                    chkTarjeta.checked = false;
                    chkTarjeta.disabled = true;
                }
                if (chkTransferencia) {
                    chkTransferencia.checked = true;
                    if (typeof toggleBanco === 'function') toggleBanco();
                }
            } else {
                divCustom.style.display = 'none';
                if (cboDefault) cboDefault.disabled = false;
                if (chkTarjeta) {
                    chkTarjeta.disabled = false;
                }
            }
        }
    }

    const contenedorExistentes = document.getElementById('contenedorFotosExistentes');
    let dragSrcExistente = null;

    if (contenedorExistentes) {
        const cardsExistentes = contenedorExistentes.querySelectorAll('.card-existente');
        cardsExistentes.forEach(card => {
            card.addEventListener('dragstart', function(e) {
                if(e.target.tagName.toLowerCase() === 'input' || e.target.tagName.toLowerCase() === 'button') { 
                    e.preventDefault(); return;
                }
                dragSrcExistente = this; 
                e.dataTransfer.effectAllowed = 'move'; 
                setTimeout(() => this.style.opacity = '0.4', 0);
            });
            card.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move'; 
                return false;
            });
            card.addEventListener('drop', function(e) {
                e.stopPropagation();
                if (dragSrcExistente !== null && 
                dragSrcExistente !== this) {
                    const allCards = Array.from(contenedorExistentes.querySelectorAll('.card-existente'));
                    const srcIndex = allCards.indexOf(dragSrcExistente);
                    const targetIndex = allCards.indexOf(this);
                    if (srcIndex < targetIndex) { 
                        this.parentNode.insertBefore(dragSrcExistente, this.nextSibling);
                    } else {
                        this.parentNode.insertBefore(dragSrcExistente, this); 
                    }
                    reindexarExistentes();
                }
                return false;
            });
            card.addEventListener('dragend', function(e) { 
                this.style.opacity = '1';
                dragSrcExistente = null;
            });
        });
    }

    function reindexarExistentes() {
        const cards = contenedorExistentes.querySelectorAll('.card-existente');
        cards.forEach((card, index) => {
            const idInput = card.querySelector('.input-id-foto');
            const descInput = card.querySelector('.input-desc-foto');
            if (idInput) idInput.name = `Galeria[${index}].Id_Foto`;
            if (descInput) descInput.name = `Galeria[${index}].Descripcion`;
        });
    }
</script>