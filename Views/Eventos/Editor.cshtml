            <div class="col-md-8"><input type="text" name="Preguntas[IDX].Texto" class="form-control form-control-sm mb-1" placeholder="¿Pregunta?" required disabled /><input type="text" name="Preguntas[IDX].Opciones" class="form-control form-control-sm bg-white inp-opciones" placeholder="Opciones separadas por |" style="display:none;" disabled /></div>
            <div class="col-md-1 text-end"><button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this, '.inp-eliminada')"><i class="fa-solid fa-trash"></i></button></div>
