﻿@using RedAJP.Globales
@model RedAJP.Models.DetalleEventoViewModel

@{
    Layout = "Principal";
    ViewData["Title"] = Model.Evento.Titulo;
    bool p_Editar = User.Identity.IsAuthenticated && User.TienePermiso(Parametros.Modulos.TiendaConfig, Parametros.Permisos.Editar);

    // =========================================================================
    // LÓGICA ANTI-CACHÉ PARA IMAGEN DINÁMICA
    // =========================================================================
    bool esDinamica = ViewBag.EsImagenDinamica != null && (bool)ViewBag.EsImagenDinamica;
    string urlPortada = Model.Evento.Imagen_Url;
    string urlPreview = Model.Evento.Imagen_Link_Preview;

    if (esDinamica && !string.IsNullOrEmpty(urlPortada))
    {
        long timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        urlPortada += (urlPortada.Contains("?") ? "&" : "?") + "t=" + timestamp;
        
        if(!string.IsNullOrEmpty(urlPreview))
        {
            urlPreview += (urlPreview.Contains("?") ? "&" : "?") + "t=" + timestamp;
        }
    }
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') activarMenu('menu-eventos');
    });
</script>

<style>
    .banner-hijo {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left: 5px solid var(--bs-primary) !important;
        background-color: #f8f9fa;
    }
    .banner-hijo:hover {
        transform: translateX(8px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        background-color: #ffffff;
    }
    .img-galeria {
        aspect-ratio: 1 / 1;
        width: 100%;
        object-fit: cover;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: block;
        background-color: #f0f0f0;
    }

        .img-galeria:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            z-index: 2;
        }

    .img-portada-container {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        background-color: #eee;
    }

    .img-portada {
        width: 100%;
        max-height: 500px;
        object-fit: cover;
    }

    .btn-inscribirse-detalle {
        background-color: var(--acento-dorado);
        border: none;
        color: var(--header-footer);
        transition: all 0.3s ease;
    }

        .btn-inscribirse-detalle:hover {
            background-color: #ffca28;
            color: var(--header-footer);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(255, 202, 40, 0.4) !important;
        }
        .btn-hover-glass {
    transition: all 0.3s ease;
}
.btn-hover-glass:hover {
    background-color: rgba(255, 255, 255, 0.3) !important;
}
</style>

<div class="container py-3 py-md-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 px-2 px-md-3">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="position-relative p-3 p-md-5 text-center rounded-top-4 overflow-hidden shadow-sm" style="color: white;">

                    <div class="position-absolute top-0 start-0 w-100 h-100"
                        style="background-image: url('@urlPortada');
                        background-size: cover;
                        background-position: center;
                        filter: blur(15px);
                        transform: scale(1.1);
                        z-index: 0;">
                    </div>
    
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark" style="opacity: 0.65; z-index: 1;"></div>

                    <div class="position-relative" style="z-index: 2;">
        
                        <div class="d-flex justify-content-between align-items-center mb-4 mb-md-5">

                            <div>
                                @if (p_Editar)
                                {
                                    <div class="btn-group rounded-pill overflow-hidden shadow-sm" style="background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px);">
                                        <a href="@Url.Action("Index")" class="btn border-end border-light border-opacity-25 px-3 py-2 text-white d-flex align-items-center justify-content-center btn-hover-glass" title="Volver a la Lista">
                                            <i class="fa-solid fa-arrow-left"></i>
                                            <span class="d-none d-md-inline fw-semibold ms-2">Eventos</span>
                                        </a>
                                        <a href="@Url.Action("PanelControl", "Eventos", new { sid = Model.Evento.Id_Encriptado_Evento })" class="btn px-3 py-2 text-white d-flex align-items-center justify-content-center btn-hover-glass" title="Ir al Panel">
                                            <i class="fa-solid fa-gauge-high text-warning"></i>
                                            <span class="d-none d-md-inline fw-bold ms-2">Panel</span>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a href="@Url.Action("Index")" class="btn rounded-circle d-flex align-items-center justify-content-center btn-hover-glass shadow-sm" style="width: 42px; height: 42px; background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); color: white;" title="Volver">
                                        <i class="fa-solid fa-arrow-left"></i>
                                    </a>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                <a href="@Url.Action("DescargarFicha", "Eventos", new { sId = Model.Evento.Id_Encriptado_Evento })"
                                       target="_blank"
                                       class="btn rounded-circle d-flex align-items-center justify-content-center btn-hover-glass shadow-sm"
                                       style="width: 42px; height: 42px; background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); color: white;"
                                       title="Ver Ficha PDF">
                                    <i class="fa-solid fa-file-pdf fs-6 text-white"></i>
                                </a>

                                @if (p_Editar)
                                {
                                    <a href="@Url.Action("Editor", new { sid = Model.Evento.Id_Encriptado_Evento })"
                                           class="btn rounded-circle d-flex align-items-center justify-content-center btn-hover-glass shadow-sm"
                                           style="width: 42px; height: 42px; background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); color: white;"
                                           title="Editar Configuración">
                                        <i class="fa-solid fa-pen fs-6 text-white"></i>
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="mx-auto pb-2" style="max-width: 850px;">
                            <h1 class="fs-2 display-md-4 fw-bold m-0 text-white" style="letter-spacing: -0.5px; line-height: 1.2; text-shadow: 0 4px 15px rgba(0,0,0,0.5);">@Model.Evento.Titulo</h1>
                        </div>
        
                    </div>
                </div>

                <div class="card-body p-3 p-md-5">

                    @if (!string.IsNullOrEmpty(Model.Evento.Imagen_Url))
                    {
                        <div class="mb-5 img-portada-container bg-light d-flex align-items-center justify-content-center" style="min-height: 200px;">
                            <a href="javascript:void(0)" class="d-block w-100" data-bs-toggle="modal" data-bs-target="#visorModal" 
                               data-img-src="@urlPreview">
                                <img src="@urlPortada"
                                        class="img-portada"
                                        alt="Foto Principal"
                                        referrerpolicy="no-referrer"
                                        loading="lazy"
                                        onerror="this.src='/img/cruz.png';">
                            </a>
                        </div>
                    }

                    <div class="row text-center mb-5 pb-4 border-bottom g-4">
                        <div class="col-6 border-end">
                            <h6 class="text-uppercase text-muted small fw-bold mb-2"><i class="fa-solid fa-calendar-day me-1 text-primary"></i> Fecha</h6>
                            <div class="fs-5 fw-bold text-dark">@Model.Evento.Fecha_Inicio.ToString("D", new System.Globalization.CultureInfo("es-MX"))</div>
                            <p class="fs-5 opacity-75 mb-0"><i class="fa-regular fa-clock me-2"></i> @Model.Evento.SoloHoraFormato</p>
                        </div>
                        <div class="col-6">
                            <h6 class="text-uppercase text-muted small fw-bold mb-2"><i class="fa-solid fa-tag me-1 text-success"></i> Costo</h6>
                            @if (Model.Subtipos.Any())
                            {
                                <div class="fs-5 fw-bold text-success">Desde $@Model.Subtipos.Min(x => x.Costo).ToString("N0")</div>
                            }
                            else if (Model.Evento.Costo > 0)
                            {
                                <div class="fs-5 fw-bold text-success">$@Model.Evento.Costo.ToString("N2")</div>
                            }
                            else
                            {
                                <div class="fs-5 fw-bold text-success">Entrada Libre</div>
                            }
                        </div>
                    </div>

                    <div class="mb-5">
                        <h5 class="fw-bold border-start border-4 border-primary ps-3 mb-3 text-dark">Acerca del Evento</h5>
                        <div class="text-muted fs-6" style="text-align: justify; line-height: 1.8;">
                        @{
                            string desc = Model.Evento.Descripcion ?? "";
                            // Detecta si hay al menos una etiqueta HTML válida (ej. <p>, <div>, <strong>, <br>)
                            bool tieneHtml = System.Text.RegularExpressions.Regex.IsMatch(desc, @"<\s*([a-zA-Z]+)[^>]*>");
        
                            // Si tiene HTML lo deja intacto, si es texto plano le aplica el reemplazo
                            string descFinal = tieneHtml ? desc : desc.Replace("\n", "<br>");
                        }
                        @Html.Raw(descFinal)
                    </div>
                    </div>
                    
                    @* BANNERS DE EVENTOS HIJOS *@
                    @if (ViewBag.EventosHijos != null && ((List<RedAJP.Models.EventoItemViewModel>)ViewBag.EventosHijos).Any())
                    {
                        long tsHijos = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(); // Timestamp para los hijos
    
                        <div class="mb-5">
                            <h5 class="fw-bold border-start border-4 border-info ps-3 mb-3 text-dark">Eventos Relacionados</h5>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var hijo in (List<RedAJP.Models.EventoItemViewModel>)ViewBag.EventosHijos)
                                {
                                    // Aplicar t=timestamp a la URL para evitar caché si la imagen acaba de ser generada
                                    string urlHijoConCache = hijo.Imagen_Url;
                                    if (!string.IsNullOrEmpty(urlHijoConCache)) {
                                        urlHijoConCache += (urlHijoConCache.Contains("?") ? "&" : "?") + "t=" + tsHijos;
                                    }

                                    <a href="@Url.Action("Detalle", "Eventos", new { sid = hijo.Id_Encriptado_Evento })" class="text-decoration-none">
                                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden banner-hijo">
                                            <div class="row g-0 align-items-center">
                            
                                                <div class="col-3 col-sm-2 bg-light d-flex justify-content-center align-items-center" style="height: 85px;">
                                                    @if (!string.IsNullOrEmpty(urlHijoConCache))
                                                    {
                                                        <img src="@urlHijoConCache" class="img-fluid" style="height: 100%; width: 100%; object-fit: cover;" alt="@hijo.Titulo">
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-calendar-star fa-2x text-muted opacity-50"></i>
                                                    }
                                                </div>
                            
                                                <div class="col-8 col-sm-9 px-3 py-2">
                                                    <h6 class="mb-1 fw-bold text-dark text-truncate">@hijo.Titulo</h6>
                                                    <small class="text-muted fw-semibold">
                                                        <i class="fa-regular fa-calendar text-primary me-1"></i> 
                                                        @hijo.Fecha_Inicio.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-MX"))
                                                    </small>
                                                </div>
                                                <div class="col-1 text-center">
                                                    <i class="fa-solid fa-chevron-right text-primary opacity-75"></i>
                                                </div>

                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.Subtipos.Any())
                    {
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="fw-bold m-0 text-primary">| Opciones de Alojamiento / Entrada</h5>
                            </div>
                            <div class="card-body p-0">
        
                                <div class="row d-none d-md-flex bg-light text-secondary small text-uppercase px-3 px-md-4 py-2 border-bottom mx-0">
                                    <div class="col-5">Modalidad</div>
                                    <div class="col-3 text-center">Precio</div>
                                    <div class="col-4 text-end">Disponibilidad</div>
                                </div>

                                <div class="list-group list-group-flush rounded-bottom-4">
                                    @foreach (var sub in Model.Subtipos.OrderByDescending(x => x.Costo).ThenBy(x => x.Nombre))
                                    {
                                        int disponibles = sub.Cupo - sub.Ocupados;
                                        bool agotado = disponibles <= 0;

                                        <div class="list-group-item px-3 px-md-4 py-3">
                                            <div class="row align-items-center">
                                                <div class="col-12 col-md-5 mb-2 mb-md-0 fw-bold text-dark">
                                                    @sub.Nombre
                                                </div>
                                                <div class="col-6 col-md-3 text-success fw-bold text-md-center align-self-end align-self-md-center">
                                                    <span class="d-md-none text-muted small fw-normal d-block mb-1">Precio</span>
                                                    $@sub.Costo.ToString("N2")
                                                </div>
                                                <div class="col-6 col-md-4 text-end align-self-end align-self-md-center">
                                                    <span class="d-md-none text-muted small fw-normal d-block mb-1">Estatus</span>
                                                    @if (agotado)
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3">Agotado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success text-white rounded-pill px-3">
                                                            <span class="d-none d-lg-inline">Disponible</span>
                                                            <span class="d-inline d-lg-none">Disp.</span>
                                                            (@disponibles)
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
        
                            </div>
                        </div>
                    }

                    @if (Model.Galeria.Any())
                    {
                        <div class="mb-5">
                            <h5 class="fw-bold border-start border-4 border-warning ps-3 mb-3 text-dark">Galería de Imágenes</h5>
                            <div class="row g-3">
                                @foreach (var foto in Model.Galeria)
                                {
                                    <div class="col-md-4 col-6">
                                        <div class="position-relative overflow-hidden rounded-3 shadow-sm h-100">
                                            <a href="javascript:void(0)" class="d-block h-100" data-bs-toggle="modal" data-bs-target="#visorModal" data-img-src="@foto.Url_Link_Preview">
                                                <img src="@foto.Url_Foto"
                                                     class="img-galeria"
                                                     alt="Foto Galeria"
                                                     referrerpolicy="no-referrer"
                                                     loading="lazy"
                                                     onerror="this.src='/img/cruz.png';">
                                            </a>
                                            @if (!string.IsNullOrEmpty(foto.Descripcion))
                                            {
                                                <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white p-2 small text-center text-truncate">@foto.Descripcion</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.Evento.Requiere_Registro)
                    {
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-5 pt-4 border-top">
        
                            @if (Model.MostrarBotonAlojamiento)
                            {
                                <a href="@Url.Action("ElegirAlojamiento", "Eventos", new { sid = Model.Evento.Id_Encriptado_Evento })" 
                                   class="btn btn-info text-white rounded-pill px-5 py-3 fw-bold shadow btn-lg text-uppercase btn-inscribirse-detalle">
                                    <i class="fa-solid fa-bed me-2 fa-lg"></i> Elegir Habitación
                                </a>
                            }
        
                            @if (Model.Evento.HayCupo)
                            {
                                <a href="@Url.Action("Registro", new { sid = Model.Evento.Id_Encriptado_Evento })" 
                                   class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow btn-lg text-uppercase btn-inscribirse-detalle">
                                    <i class="fa-solid fa-ticket me-2 fa-lg"></i> Inscribirse Ahora
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary rounded-pill px-5 py-3 fw-bold shadow btn-lg text-uppercase" disabled>
                                    <i class="fa-solid fa-ban me-2"></i> Cupo Completo
                                </button>
                            }
                        </div>
                    }

                    <!-- DOCUMENTOS OFICIALES DEL EVENTO -->
                    <div class="card border-0 bg-light rounded-4 p-4 mt-5 mb-3 shadow-sm border-start border-4 border-primary">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fa-solid fa-shield-cat text-primary me-2"></i>Documentos Oficiales e Información Legal
                        </h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="bg-white p-3 rounded-3 border d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-xs">
                                    <div class="d-flex align-items-center">
                                        <i class="fa-solid fa-file-pdf text-danger fs-3 me-3"></i>
                                        <div>
                                            <div class="fw-bold text-dark small">Términos y Condiciones</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Reglamento de participación</small>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 w-100 w-sm-auto mt-2 mt-sm-0">
                                        @if (!string.IsNullOrEmpty(ViewBag.UrlTerminos as string))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill flex-fill" onclick="abrirLectorPDF('Términos y Condiciones', '@ViewBag.UrlTerminos')">
                                                <i class="fa-solid fa-eye me-1"></i> Ver
                                            </button>
                                            <a href="@ViewBag.UrlTerminos" target="_blank" download="Terminos_Condiciones_Participacion.pdf" class="btn btn-sm btn-primary rounded-pill flex-fill">
                                                <i class="fa-solid fa-download me-1"></i> Descargar
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">Próximamente</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="bg-white p-3 rounded-3 border d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-xs">
                                    <div class="d-flex align-items-center">
                                        <i class="fa-solid fa-file-shield text-info fs-3 me-3"></i>
                                        <div>
                                            <div class="fw-bold text-dark small">Aviso de Privacidad</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Protección de datos personales</small>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 w-100 w-sm-auto mt-2 mt-sm-0">
                                        @if (!string.IsNullOrEmpty(ViewBag.UrlPrivacidad as string))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill flex-fill" onclick="abrirLectorPDF('Aviso de Privacidad', '@ViewBag.UrlPrivacidad')">
                                                <i class="fa-solid fa-eye me-1"></i> Ver
                                            </button>
                                            <a href="@ViewBag.UrlPrivacidad" target="_blank" download="Aviso_de_Privacidad.pdf" class="btn btn-sm btn-info text-white rounded-pill flex-fill">
                                                <i class="fa-solid fa-download me-1"></i> Descargar
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">Próximamente</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="visorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0 justify-content-end position-absolute top-0 end-0 z-3" style="background: transparent !important;">
                <button type="button" class="btn-close btn-close-white shadow-none p-3" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(0,0,0,0.5); border-radius: 50%; margin: 10px;"></button>
            </div>
            <div class="modal-body text-center p-0 position-relative">
                <img src="" id="imagenModal" class="img-fluid rounded-3 shadow-lg" alt="Vista ampliada" style="max-height: 85vh; object-fit: contain; background-color: rgba(0,0,0,0.8);">
            </div>
        </div>
    </div>
</div>
<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') activarMenu('menu-eventos');
        
        // Lógica para el Modal de Imágenes
        var visorModal = document.getElementById('visorModal');
        if (visorModal) {
            visorModal.addEventListener('show.bs.modal', function (event) {
                // Elemento que disparó el modal (el enlace <a>)
                var triggerElement = event.relatedTarget; 
                // Extraer la URL de la imagen del atributo data-img-src
                var urlImagen = triggerElement.getAttribute('data-img-src'); 
                // Actualizar el src de la imagen dentro del modal
                var imagenEnModal = document.getElementById('imagenModal');
                imagenEnModal.src = urlImagen;
            });

            // Limpiar la imagen al cerrar para evitar "flashes" de la imagen anterior al abrir una nueva
            visorModal.addEventListener('hidden.bs.modal', function () {
                document.getElementById('imagenModal').src = '';
            });
        }
    });

    function abrirLectorPDF(titulo, url) {
        const esMovil = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
        if (esMovil) {
            window.open(url, '_blank');
        } else {
            document.getElementById('pdfModalTitle').textContent = titulo;
            document.getElementById('pdfIframe').src = url;
            document.getElementById('btnPdfDownloadModal').href = url;
            new bootstrap.Modal(document.getElementById('modalLectorPDF')).show();
        }
    }
</script>

<!-- Modal Lector PDF Adaptativo -->
<div class="modal fade" id="modalLectorPDF" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl h-100 my-0 py-4">
        <div class="modal-content rounded-4 border-0 shadow-lg h-100 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3" style="background: var(--bs-dark) !important;">
                <h5 class="modal-title fw-bold" id="pdfModalTitle">Visor de Documento</h5>
                <div class="d-flex align-items-center gap-2">
                    <a id="btnPdfDownloadModal" href="#" target="_blank" download class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="fa-solid fa-download me-1"></i> Descargar
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0 bg-secondary bg-opacity-10 h-100">
                <iframe id="pdfIframe" src="" class="w-100 h-100 border-0"></iframe>
            </div>
        </div>
    </div>
</div>