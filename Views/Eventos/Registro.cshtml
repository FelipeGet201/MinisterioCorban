@using RedAJP.Models
@using RedAJP.Globales
@using Npgsql
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model RedAJP.Models.RegistroEventoViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = "Registro al Evento";

    // 1. Datos del Evento
    int idEvento = ViewBag.Id_Evento != null ? Convert.ToInt32(ViewBag.Id_Evento) : 0;
    string sidEventoEncriptado = ViewBag.Id_Evento_Encriptado != null ? Convert.ToString(ViewBag.Id_Evento_Encriptado) : "";
    string titulo = ViewBag.TituloEvento as string ?? "Evento";
    decimal costoBase = ViewBag.CostoUnitario != null ? Convert.ToDecimal(ViewBag.CostoUnitario) : 0;
    
    // Bandera de Bloqueo
    bool eventoBloqueado = ViewBag.EventoBloqueado != null && (bool)ViewBag.EventoBloqueado;

    // 2. Configuración
    int tipoRegistro = ViewBag.TipoRegistro != null ? Convert.ToInt32(ViewBag.TipoRegistro) : 1;
    bool esGrupal = tipoRegistro == 2;
    bool permitirPago = ViewBag.Permitir_Pago != null && (bool)ViewBag.Permitir_Pago;

    // 3. Cupos
    int cupoMax = ViewBag.CupoMaximo != null ? (int)ViewBag.CupoMaximo : 0;
    int ocupados = ViewBag.TotalOcupados != null ? (int)ViewBag.TotalOcupados : 0;
    bool hayCupo = cupoMax == 0 || ocupados < cupoMax;
    int lugaresDisponibles = cupoMax == 0 ? 9999 : (cupoMax - ocupados);

    // 4. Listas de Datos
    var preguntasDef = ViewBag.PreguntasDefinidas as List<PreguntaDefinicion> ?? new List<PreguntaDefinicion>();
    var registrados = ViewBag.Registrados as List<AsistenteRegistrado> ?? new List<AsistenteRegistrado>();
    var subtipos = (ViewBag.Subtipos as List<SubtipoEventoItem> ?? new List<SubtipoEventoItem>()).OrderByDescending(x => x.Costo).ThenBy(x => x.Nombre).ToList();
    bool tieneHistorial = registrados.Count > 0;
    
    // Si está bloqueado, nunca abrimos el formulario inicial
    bool iniciarFormularioAbierto = !tieneHistorial && hayCupo && !eventoBloqueado;

    var listaGrupos = registrados.Select(r => r.EtiquetaGrupo)
                                 .Where(g => !string.IsNullOrWhiteSpace(g))
                                 .Distinct()
                                 .OrderBy(g => g)
                                 .ToList();

    // 5. Propuesta Automática
    var listaPropuesta = ViewBag.Asistentes as List<AsistenteItem> ?? new List<AsistenteItem>();

    var jsonSubtipos = System.Text.Json.JsonSerializer.Serialize(subtipos);
    var jsonProductosExtra = System.Text.Json.JsonSerializer.Serialize(ViewBag.ProductosExtra as List<ProductoExtraItem> ?? new List<ProductoExtraItem>());
    var jsonPropuesta = System.Text.Json.JsonSerializer.Serialize(listaPropuesta);
    var jsonRegistrados = System.Text.Json.JsonSerializer.Serialize(registrados);

    // 6. CÁLCULO PARA EL TEMPORIZADOR FLOTANTE GLOBAL
    var pendientesDePago = registrados.Where(r => !r.EstaLiquidadado && !r.EstaBloqueado && r.PagosRealizados == 0);
    int segundosRestantesGlobal = pendientesDePago.Any() ? pendientesDePago.Max(r => r.SegundosRestantesApartado) : 0;
}

<script>
    window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') activarMenu('menu-eventos');
    });
    var dataSubtipos = @Html.Raw(jsonSubtipos);
    var asistentesPropuestos = @Html.Raw(jsonPropuesta);
    var listaRegistrados = @Html.Raw(jsonRegistrados);
    var catalogoExtras = @Html.Raw(jsonProductosExtra);
</script>

