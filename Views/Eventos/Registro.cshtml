    function insertarFilaEnDOM(nombreVal, edadVal, generoVal, grupoVal) {
        var actuales = document.querySelectorAll('.fila-persona').length;
        if (!esGrupal && actuales >= 1) return;
        if (actuales >= maxLugares) { alert("Cupo lleno."); return; }

        var template = document.getElementById('tplFila').innerHTML;
        var html = template.replace(/IDX/g, '9999');
        var div = document.createElement('div');
        div.innerHTML = html;

        if(nombreVal) { var inp = div.querySelector('.inp-nombre'); if(inp) inp.value = nombreVal; }
        if(grupoVal) { var inpG = div.querySelector('.inp-grupo'); if(inpG) inpG.value = grupoVal; }
        if(edadVal && edadVal > 0) { var inpEdad = div.querySelector('.inp-edad'); if(inpEdad) inpEdad.value = edadVal; }
        if(generoVal) { var sel = div.querySelector('.sel-genero'); if(sel) sel.value = generoVal; }

        document.getElementById('contenedorAsistentes').appendChild(div.firstElementChild);
        reindexar();
    }

