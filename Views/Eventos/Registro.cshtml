<script>
    // --- VARIABLES GLOBALES ---
    var maxLugares = @lugaresDisponibles;
    var esGrupal = @(esGrupal.ToString().ToLower());
    var costoBaseGeneral = @costoBase;
    var timerInterval = null;
    var tiempoRestanteBD = @segundosRestantesGlobal;
    var idParaBorrar = 0;
    var modalBorrarBS = null;

    document.addEventListener("DOMContentLoaded", function() {
        var collapses = document.querySelectorAll('.collapse');
        collapses.forEach(el => {
            el.addEventListener('show.bs.collapse', function () { var btn = document.querySelector(`[data-bs-target="#${this.id}"]`); if(btn) btn.querySelector('.icono-toggle').classList.replace('fa-circle-plus', 'fa-circle-minus'); });
            el.addEventListener('hide.bs.collapse', function () { var btn = document.querySelector(`[data-bs-target="#${this.id}"]`); if(btn) btn.querySelector('.icono-toggle').classList.replace('fa-circle-minus', 'fa-circle-plus'); });
        });

        // Inicializar Propuesta Automática (Si el form está visible)
        if (!document.getElementById('cardNuevoRegistro').classList.contains('oculto') && document.querySelectorAll('.fila-persona').length === 0) {
            inicializarFilas();
        }

        // Sincronizar select con hidden input en el modal si está deshabilitado
        var editSub = document.getElementById('edit_subtipo');
        var hdnSub = document.getElementById('hdn_edit_subtipo');
        if(editSub && hdnSub) {
            editSub.addEventListener('change', function() { hdnSub.value = this.value; });
        }

        // Inicializar el modal de borrado
        var elModal = document.getElementById('modalBorrar');
        if(elModal) modalBorrarBS = new bootstrap.Modal(elModal);

        // INICIALIZAR CONTADOR VISUAL BASADO EN LA BD
        inicializarContador();
    });

    // --- LÓGICA DE FILTRADO Y GRUPOS ---
    function filtrarGrupo(grupo) {
        document.querySelectorAll('#pills-tab .nav-link').forEach(btn => {
            btn.classList.toggle('active', btn.innerText === grupo);
        });
        document.querySelectorAll('.fila-asistente').forEach(fila => {
            if (grupo === 'Todos') { fila.classList.remove('fila-oculta'); } 
            else { fila.classList.toggle('fila-oculta', fila.dataset.grupo !== grupo); }
        });
        // Resetear el check global al cambiar de tab para evitar confusiones visuales
        var chkGlobal = document.getElementById('chkTodos');
        if(chkGlobal) chkGlobal.checked = false;
        
        // Ejecutar manualmente la deselección de checks ocultos y evaluar
        var checkboxes = document.querySelectorAll('.chk-persona');
        for(var i=0; i<checkboxes.length; i++) { 
            if(checkboxes[i].closest('.fila-asistente').classList.contains('fila-oculta')) {
                checkboxes[i].checked = false;
            }
        }
        verificarSeleccion();
    }

    function abrirModalGrupo() {
        new bootstrap.Modal(document.getElementById('modalMasivoGrupo')).show();
    }

    async function aplicarGrupoMasivo() {
        const ids = Array.from(document.querySelectorAll('.chk-persona:checked')).map(c => c.value);
        const grupo = document.getElementById('txtNuevoGrupoMasivo').value;
        if(!grupo) { alert("Escribe un nombre de grupo"); return; }
        
        const params = new URLSearchParams();
        params.append('idEvento', '@idEvento');
        params.append('nuevoGrupo', grupo);
        ids.forEach(id => params.append('idsAsistentes', id));

        const resp = await fetch('@Url.Action("ActualizarGrupoMasivo")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params
        });
        if (resp.ok) window.location.reload();
        else alert("Error al actualizar");
    }

    // --- LÓGICA DEL CONTADOR VISUAL ---
    function inicializarContador() {
        var timerElement = document.getElementById('floating-timer');
        // Solo mostrar si realmente hay tiempo restante extraído de la BD
        if (tiempoRestanteBD > 0) {
            timerElement.classList.remove('d-none');
            iniciarReloj();
        } else {
            timerElement.classList.add('d-none');
            if(timerInterval) clearInterval(timerInterval);
        }
    }

    function iniciarReloj() {
        if(timerInterval) clearInterval(timerInterval);
        var display = document.getElementById('countdown-display');
        var container = document.getElementById('floating-timer');

        // Pintado inicial inmediato
        actualizarUI(display, container);
        timerInterval = setInterval(function() {
            tiempoRestanteBD--;
            
            if (tiempoRestanteBD <= 0) {
                // El tiempo expiró
                clearInterval(timerInterval);
                tiempoRestanteBD = 0;
    
                actualizarUI(display, container);
                
                // Refrescamos la página automáticamente a los 3 segundos para que los lugares 
                // se liberen visualmente y desaparezca el registro del usuario (se vuelve fantasma).
                setTimeout(function() {
                    window.location.reload(); 
                }, 3000); 

            } else {
                actualizarUI(display, container);
            }
        }, 1000);
    }

    function actualizarUI(display, container) {
        if (tiempoRestanteBD <= 0) {
            display.innerText = "00:00";
            display.classList.add('text-danger');
            document.getElementById('timer-title').innerText = "Tiempo Expirado";
            document.getElementById('timer-subtitle').innerText = "Actualizando disponibilidad...";
            container.style.background = 'linear-gradient(135deg, #c0392b 0%, #96281b 100%)';
        } else {
            var m = Math.floor(tiempoRestanteBD / 60);
            var s = tiempoRestanteBD % 60;
            display.innerText = (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
            // Alerta visual de los últimos 5 minutos (Rojo)
            if(tiempoRestanteBD <= 300) {
                container.style.background = 'linear-gradient(135deg, #e74c3c 0%, #c0392b 100%)';
                display.style.color = "#ffc107";
            } else {
                // Estado Normal (Azul Corporativo)
                container.style.background = 'linear-gradient(135deg, #1e3c72 0%, #2a5298 100%)';
                display.style.color = "white";
            }
        }
    }
