<div class="container py-5 fade-in" style="padding-bottom: 100px !important;">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="header-evento mb-4 position-relative text-center">
                <a href="@Url.Action("Detalle", new { sid = sidEventoEncriptado })" class="btn-volver-arriba rounded-circle position-absolute top-0 start-0 mt-1"><i class="fa-solid fa-arrow-left"></i></a>
                <h2 class="fw-bold mb-2">@titulo</h2>
                
                <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
                    @if (!subtipos.Any())
                    {
                        <span class="badge badge-costo rounded-pill px-3 py-2"><i class="fa-solid fa-tag me-1"></i> $@costoBase.ToString("N2") / persona</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill px-3 py-2 fw-bold" style="background-color: rgba(14, 165, 233, 0.15); color: var(--primary); border: 1px solid rgba(14, 165, 233, 0.3);"><i class="fa-solid fa-layer-group me-1"></i> Precios Variados</span>
                    }
                </div>

                <!-- BOTONES DISCRETOS DE DOCUMENTOS LEGALES -->
                <div class="mt-2 d-flex justify-content-center align-items-center flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(ViewBag.UrlTerminos as string))
                    {
                        <button type="button" class="btn btn-sm bg-white text-secondary border shadow-xs rounded-pill px-3 py-1 fw-semibold small" onclick="abrirLectorPDF('Términos y Condiciones', '@ViewBag.UrlTerminos')" title="Ver Términos y Condiciones">
                            <i class="fa-solid fa-scale-balanced text-warning me-1"></i> Términos
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.UrlPrivacidad as string))
                    {
                        <button type="button" class="btn btn-sm bg-white text-secondary border shadow-xs rounded-pill px-3 py-1 fw-semibold small" onclick="abrirLectorPDF('Aviso de Privacidad', '@ViewBag.UrlPrivacidad')" title="Ver Aviso de Privacidad">
                            <i class="fa-solid fa-shield-halved text-info me-1"></i> Privacidad
                        </button>
                    }
                </div>
            </div>

            @if (eventoBloqueado)
            {
                <div class="alert alert-danger shadow-sm border-0 rounded-4 p-4 mb-4 d-flex align-items-center">
                    <i class="fa-solid fa-lock fa-2x me-3 opacity-75"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Evento Bloqueado por Logística</h6>
                        <p class="mb-0 small">El evento ya no admite nuevas inscripciones ni modificaciones. Sin embargo, puedes continuar y liquidar tus pagos pendientes con normalidad.</p>
                    </div>
                </div>
            }

            <div class="row g-4 mb-4 @(hayCupo && ViewBag.TieneMapa != null && (bool)ViewBag.TieneMapa && !eventoBloqueado ? "justify-content-between" : "justify-content-end")">
                @if (hayCupo && ViewBag.TieneMapa != null && (bool)ViewBag.TieneMapa && !eventoBloqueado)
                {
                    <div class="col-12 col-md-5 col-lg-4">
                        <div class="text-white opacity-75 mb-1 text-center text-md-start" style="font-size: 0.7rem;">
                            <i class="fa-solid fa-circle-info me-1"></i> Aparta lugares antes de que se agoten.
                        </div>
                        <a href="@Url.Action("RegistroRapido", new { sid = sidEventoEncriptado })" 
                            class="btn btn-warning rounded-pill fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center py-2">
                            <i class="fa-solid fa-bolt me-2"></i> Pre-Registro Rápido
                        </a>
                    </div>
                }
                @if (tieneHistorial)
                {
                    <div class="@(ViewBag.TieneMapa != null && (bool)ViewBag.TieneMapa && !eventoBloqueado ? "col-12 col-md-5 col-lg-4 d-flex align-items-end" : "col-12 col-md-auto")">
                        <a href="@Url.Action("MisTransferencias", new { sid = sidEventoEncriptado })" 
                            class="btn btn-historial rounded-pill fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center py-2 px-4">
                            <i class="fa-solid fa-list-ul me-2"></i> Ver Mis Transferencias
                        </a>
                    </div>
                }
            </div>

            @if (tieneHistorial)
            {                
                @if (esGrupal)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <ul class="nav nav-pills" id="pills-tab">
                            @if (listaGrupos.Count > 1)
                            {
                                <li class="nav-item">
                                    <button type="button" class="nav-link active" onclick="filtrarGrupo('Todos')">Todos</button>
                                </li>
                            }
                            @foreach (var grupo in listaGrupos)
                            {
                                <li class="nav-item">
                                    <button type="button" class="nav-link @(listaGrupos.Count == 1 ? "active" : "")" onclick="filtrarGrupo('@grupo')">@grupo</button>
                                </li>
                            }
                        </ul>
        
                        @if (!eventoBloqueado)
                        {
                            <div id="btnOrganizar" class="d-none">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold" onclick="abrirModalGrupo()">
                                    <i class="fa-solid fa-folder-plus me-1 text-primary"></i> Mover a Grupo
                                </button>
                            </div>
                        }
                    </div>
                }

                <form action="@Url.Action("PrepararPago")" method="post" id="formPagarSeleccionados">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idEvento" value="@idEvento" />

                    <div class="card border-0 shadow-lg rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-list-check me-2 text-primary"></i>Tu Lista (@registrados.Count)</h6>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 ms-1 text-muted d-inline-flex align-items-center gap-1 border-0 shadow-none btn-ayuda-discreta" data-bs-toggle="modal" data-bs-target="#modalGuiaBotones" title="Guía de Botones e Iconos">
                                    <i class="fa-solid fa-circle-question text-primary opacity-75 fs-6"></i>
                                    <span class="small text-muted fw-semibold" style="font-size: 0.8rem;">¿Qué hace cada botón?</span>
                                </button>
                            </div>
                            @if (permitirPago)
                            {
                                <div class="form-check form-switch small m-0">
                                    <input class="form-check-input" type="checkbox" id="chkTodos" onchange="toggleTodos(this)">
                                    <label class="form-check-label text-muted cursor-pointer" for="chkTodos">Seleccionar visibles</label>
                                </div>
                            }
                        </div>

                        <div class="p-0 bg-white"> 
                            <div class="table-responsive"> 
                                <table class="table table-hover mb-0 align-middle responsive-table border-0" style="border-radius: 0;">
                                    <thead class="tabla-header-azul text-uppercase small">
                                        <tr>
                                            <th class="ps-4 py-3" style="width: 50px;">#</th>
                                            <th class="py-3">Nombre</th>
                                            <th class="py-3">Modalidad / Costo</th>
                                            <th class="text-center py-3">Estado</th>
                                            <th class="text-end pe-4 py-3" style="min-width: 140px;">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in registrados)
                                        {
                                            string jsonR = System.Text.Json.JsonSerializer.Serialize(item.Respuestas);
                                            <tr class="fila-asistente" data-grupo="@item.EtiquetaGrupo">
                                                <td class="ps-4" data-label="Selección">
                                                    @if (item.EstaLiquidadado)
                                                    {
                                                        <i class="fa-solid fa-check text-success small"></i>
                                                    }
                                                    else if (permitirPago)
                                                    {
                                                        if (item.EstaBloqueado)
                                                        {
                                                            if (item.EstatusTransaccion == "waiting_proof")
                                                            {
                                                                <i class="fa-solid fa-clock text-warning" title="Pendiente de subir comprobante" style="cursor: help;"></i>
                                                            }
                                                            else if (item.EstatusTransaccion == "rejected")
                                                            {
                                                                <i class="fa-solid fa-circle-exclamation text-danger" title="Transferencia rechazada" style="cursor: help;"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fa-solid fa-hourglass-half text-primary" title="En revisión" style="cursor: help;"></i>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <input type="checkbox" name="idsSeleccionados" value="@item.Id_Asistente" 
                                                                   class="form-check-input chk-persona" 
                                                                   data-pendiente="@(item.NombreCompleto == "(PENDIENTE)" ? "true" : "false")"
                                                                   onchange="verificarSeleccion()">
                                                        }
                                                    }
                                                </td>
                                                <td data-label="Asistente">
                                                    <div class="d-flex align-items-center">
                                                        <button type="button" class="btn-expandir me-2" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id_Asistente" title="Ver detalles">
                                                            <i class="fa-solid fa-circle-plus fs-5 icono-toggle"></i>
                                                        </button>
                                                        <div>
                                                            <div class="fw-bold text-secondary">@item.NombreCompleto</div>
                                                            @if (esGrupal)
                                                            {
                                                                <span class="badge badge-grupo rounded-pill mt-1">@item.EtiquetaGrupo</span>
                                                            }

                                                            @if (ViewBag.TieneEncuestaRequisito == true)
                                                            {
                                                                if (item.EncuestaRespondida)
                                                                {
                                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-2 py-1 mt-1 d-inline-block" style="font-size: 0.7rem;" title="Encuesta contestada">
                                                                        <i class="fa-solid fa-clipboard-check me-1"></i> Encuesta Lista
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    var linkEncuestaAsis = Url.Action("Responder", "Encuestas", new { clave = ViewBag.UrlEncuesta, asis = item.Id_Asistente, retorno = item.TokenExterno });
                                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-2 py-1 mt-1 cursor-pointer d-inline-block" 
                                                                          style="font-size: 0.7rem;" 
                                                                          title="Encuesta pendiente de contestar"
                                                                          onclick="mostrarAlertaEncuestaPendiente('@Html.Raw(item.NombreCompleto.Replace("'", "\\'"))', '@linkEncuestaAsis')">
                                                                        <i class="fa-solid fa-clipboard-question me-1"></i> Encuesta Pendiente
                                                                    </span>
                                                                }
                                                            }
                                                        </div>
                                                        @if (!item.EstaLiquidadado && !item.EstaBloqueado && item.PagosRealizados == 0 && item.SegundosRestantesApartado > 0)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-2 pulse-animation" title="El lugar se liberará si el temporizador llega a cero" style="font-size: 0.65rem;">
                                                                <i class="fa-solid fa-stopwatch me-1"></i> Reserva
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="small" data-label="Modalidad / Costo">
                                                    <div class="fw-bold text-dark">@(item.NombreSubtipo ?? "General")</div>
                                                    <div class="text-muted">
                                                        @if (item.CostoExtras > 0)
                                                        {
                                                            <span>$@item.CostoBaseModalidad.ToString("N2")</span>
                                                            <span class="badge bg-secondary ms-1 fw-normal" title="Incluye adicionales">+ $@item.CostoExtras.ToString("N2") Extras</span>
                                                            <div class="fw-bold text-dark mt-1" style="font-size: 0.8rem;">Total: $@item.CostoReal.ToString("N2")</div>
                                                        }
                                                        else
                                                        {
                                                            <span>$@item.CostoReal.ToString("N2")</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center" data-label="Estatus de Pago">
                                                    @if (item.EstaLiquidadado)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">
                                                            <i class="fa-solid fa-check-double me-1"></i> Completado
                                                        </span>
                                                    }
                                                    else if (item.EstaBloqueado)
                                                    {
                                                        if (item.EstatusTransaccion == "rejected")
                                                        {
                                                            <a href="@Url.Action("RetomarTransferencia", "Eventos", new { idTransaccion = item.IdTransaccionPendiente })" class="badge-granular bg-danger text-white border-0 shadow-sm">
                                                                <i class="fa-solid fa-rotate-right"></i> Corregir
                                                            </a>
                                                        }
                                                        else if (item.EstatusTransaccion == "waiting_proof")
                                                        {
                                                            <a href="@Url.Action("RetomarTransferencia", "Eventos", new { idTransaccion = item.IdTransaccionPendiente })" class="badge-granular bg-warning text-dark border-0 shadow-sm">
                                                                <i class="fa-solid fa-upload"></i> Subir Foto
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-granular bg-primary bg-opacity-10 text-primary border border-primary cursor-pointer" title="Tu pago está siendo validado por un administrador">
                                                                <i class="fa-solid fa-magnifying-glass"></i> En Revisión
                                                            </span>
                                                        }
                                                    }
                                                    else if (item.TieneVencidos)
                                                    {
                                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 fw-bold">
                                                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Atrasado (@item.PagosRealizados/@item.TotalPagosCalendario)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @if (item.PagosRealizados == 0 && item.SegundosRestantesApartado > 0)
                                                        {
                                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 pulse-animation" title="Requiere pago inmediato">
                                                                <i class="fa-solid fa-stopwatch me-1"></i> Por Pagar
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3">
                                                                <i class="fa-solid fa-check me-1"></i> En Curso (@item.PagosRealizados/@item.TotalPagosCalendario)
                                                            </span>
                                                        }
                                                    }
                                                </td>
                                                <td class="text-end pe-lg-4" data-label="Acciones">
                                                    <div class="d-flex justify-content-end">
                                                        @if (item.NombreCompleto != "(PENDIENTE)")
                                                        {
                                                            var tieneEncuestaReq = (ViewBag.TieneEncuestaRequisito == true);
                                                            var encRespondida = item.EncuestaRespondida;
                                                            var linkEncuestaAsis = tieneEncuestaReq ? Url.Action("Responder", "Encuestas", new { clave = ViewBag.UrlEncuesta, asis = item.Id_Asistente, retorno = item.TokenExterno }) : "";

                                                            <a href="@Url.Action("Pagar", "Eventos", new { token = item.TokenExterno })" target="_blank" class="btn-accion ver" title="Ver Estado de Cuenta"><i class="fa-solid fa-eye"></i></a>
                                                            <button type="button" class="btn-accion share" title="Copiar Link" onclick="copiarLinkPago('@item.TokenExterno', '@item.NombreCompleto')"><i class="fa-solid fa-share-nodes"></i></button>

                                                            @if (tieneEncuestaReq && !encRespondida)
                                                            {
                                                                <button type="button" class="btn-accion" style="color: #dc3545;" title="Encuesta Pendiente (QR Bloqueado)" onclick="mostrarAlertaEncuestaPendiente('@Html.Raw(item.NombreCompleto.Replace("'", "\\'"))', '@linkEncuestaAsis')"><i class="fa-solid fa-qrcode"></i></button>
                                                                <a href="@linkEncuestaAsis" target="_blank" class="btn-accion" style="color: #fd7e14;" title="Responder Encuesta"><i class="fa-solid fa-square-poll-vertical"></i></a>
                                                                <button type="button" class="btn-accion share" style="color: #6f42c1;" title="Copiar Link de Encuesta" onclick="copiarLinkEncuesta('@linkEncuestaAsis', '@Html.Raw(item.NombreCompleto.Replace("'", "\\'"))')"><i class="fa-solid fa-link"></i></button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="btn-accion" style="color: #0d6efd;" title="Mostrar QR de Acceso" onclick="mostrarQR('@item.TokenExterno', '@Html.Raw(item.NombreCompleto.Replace("'", "\\'"))', @item.EstaLiquidadado.ToString().ToLower())"><i class="fa-solid fa-qrcode"></i></button>
                                                            }
                                                        }

                                                        @if (!item.EstaBloqueado && !eventoBloqueado)
                                                        {
                                                            <button type="button" class="btn-accion edit" title="Editar" data-id="@item.Id_Asistente" onclick="prepararEdicion(@item.Id_Asistente)">
                                                                <i class="fa-solid fa-pen-to-square"></i>
                                                            </button>
                                                            @if (item.PagosRealizados == 0 && !item.EstaLiquidadado)
                                                            {
                                                                <button type="button" class="btn-accion del" title="Borrar" onclick="confirmarBorrar(@item.Id_Asistente, '@item.NombreCompleto')">
                                                                    <i class="fa-solid fa-trash"></i>
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="collapse bg-light bg-opacity-25" id="collapse-@item.Id_Asistente">
                                                <td colspan="5" class="p-0">
                                                    <div class="p-4 border-bottom">
                                                        <div class="row g-3">
                                                            <div class="col-md-3"><small class="text-muted fw-bold d-block">Edad</small><span>@item.Edad años</span></div>
                                                            <div class="col-md-3"><small class="text-muted fw-bold d-block">Género</small><span>@(item.Genero == "H" ? "Hombre" : "Mujer")</span></div>
                                                            @foreach (var preg in preguntasDef)
                                                            {
                                                                var resp = item.Respuestas.FirstOrDefault(r => r.Id_Pregunta == preg.Id_Pregunta);
                                                                var valor = resp != null ? resp.Valor : "-";
                                                                <div class="col-md-3">
                                                                    <small class="text-muted fw-bold d-block" title="@preg.Texto">@preg.Texto</small>
                                                                    <span class="text-dark">@valor</span>
                                                                </div>
                                                            }
                                                            @if (item.ProductosExtra != null && item.ProductosExtra.Any())
                                                            {
                                                                <div class="col-12 mt-2 pt-2 border-top">
                                                                    <small class="text-muted fw-bold d-block mb-1">
                                                                        <i class="fa-solid fa-cart-plus me-1 text-primary"></i>Productos Opcionales (Extras):
                                                                    </small>
                                                                    <div class="d-flex flex-wrap gap-2">
                                                                        @foreach (var ext in item.ProductosExtra)
                                                                        {
                                                                            <span class="badge bg-white text-dark border shadow-sm p-2">
                                                                                <span class="fw-bold">@ext.NombreProducto</span> (x@(ext.CantidadComprada)): $@ext.Total.ToString("N2")
                                                                                @if (ext.CantidadPagada > 0)
                                                                                {
                                                                                    <span class="text-success ms-2"><i class="fa-solid fa-circle-check"></i> @ext.CantidadPagada pagada@(ext.CantidadPagada > 1 ? "s" : "")</span>
                                                                                }
                                                                                @if (ext.CantidadPendiente > 0)
                                                                                {
                                                                                    <span class="text-secondary ms-2"><i class="fa-solid fa-clock"></i> @ext.CantidadPendiente pendiente@(ext.CantidadPendiente > 1 ? "s" : "")</span>
                                                                                }
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @if (permitirPago)
                        {
                            <div class="card-footer bg-light border-0 p-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="small text-muted fst-italic">
                                        <span><i class="fa-solid fa-info-circle me-1"></i>Puedes seleccionar varias personas para realizar pagos en grupo.</span>
                                    </div>
                                    <button type="submit" id="btnPagarMasa" class="btn btn-warning fw-bold shadow-sm px-4 rounded-pill py-2 w-100 btn-width-md-auto" disabled>
                                        Ir a Pagar <i class="fa-solid fa-chevron-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </form>
            }

            @if (hayCupo && !eventoBloqueado)
            {
                @if (tieneHistorial && esGrupal)
                {
                    <div id="botonAbrirFormulario" class="text-center mb-4 @(iniciarFormularioAbierto ? "oculto" : "")">
                        <button type="button" class="btn btn-outline-light rounded-pill px-4 fw-bold border-2" onclick="abrirNuevoRegistro()">
                            <i class="fa-solid fa-plus me-1"></i> Agregar a alguien más
                        </button>
                    </div>
                }

                @if (!tieneHistorial)
                {
                    <!-- PANTALLA DE ACEPTACIÓN LEGAL PREVIA -->
                    <div id="cardAceptacionLegal" class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
                    <div class="card-header bg-dark text-white p-3 ps-4 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-scale-balanced me-2 text-warning"></i> Términos de Participación y Aviso de Privacidad</h6>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p class="text-secondary fw-semibold mb-4">
                            Para continuar con la inscripción a este evento, es indispensable leer y aceptar los términos y condiciones de participación así como nuestro aviso de privacidad integral.
                        </p>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa-solid fa-file-pdf text-danger fs-4 me-2"></i>
                                            <span class="fw-bold text-dark">Términos y Condiciones</span>
                                        </div>
                                        <small class="text-muted d-block mb-3">Reglamento y condiciones de participación del evento.</small>
                                    </div>
                                    <div>
                                        @if (!string.IsNullOrEmpty(ViewBag.UrlTerminos as string))
                                        {
                                            <div class="d-flex gap-2 mb-3">
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill flex-fill" onclick="abrirLectorPDF('Términos y Condiciones', '@ViewBag.UrlTerminos')">
                                                    <i class="fa-solid fa-eye me-1"></i> Leer PDF
                                                </button>
                                                <a href="@ViewBag.UrlTerminos" target="_blank" download="Terminos_Condiciones.pdf" class="btn btn-sm btn-primary rounded-pill flex-fill">
                                                    <i class="fa-solid fa-download me-1"></i> Descargar
                                                </a>
                                            </div>
                                        }
                                        <div class="form-check">
                                            <input class="form-check-input chk-legal-req" type="checkbox" id="chkTerminosLegal" onchange="evaluarAceptacionLegal()">
                                            <label class="form-check-label fw-bold text-dark small cursor-pointer" for="chkTerminosLegal">
                                                He leído y acepto los Términos y Condiciones de Participación
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa-solid fa-file-shield text-info fs-4 me-2"></i>
                                            <span class="fw-bold text-dark">Aviso de Privacidad</span>
                                        </div>
                                        <small class="text-muted d-block mb-3">Lineamientos sobre el tratamiento y protección de datos personales.</small>
                                    </div>
                                    <div>
                                        @if (!string.IsNullOrEmpty(ViewBag.UrlPrivacidad as string))
                                        {
                                            <div class="d-flex gap-2 mb-3">
                                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill flex-fill" onclick="abrirLectorPDF('Aviso de Privacidad', '@ViewBag.UrlPrivacidad')">
                                                    <i class="fa-solid fa-eye me-1"></i> Leer PDF
                                                </button>
                                                <a href="@ViewBag.UrlPrivacidad" target="_blank" download="Aviso_Privacidad.pdf" class="btn btn-sm btn-info text-white rounded-pill flex-fill">
                                                    <i class="fa-solid fa-download me-1"></i> Descargar
                                                </a>
                                            </div>
                                        }
                                        <div class="form-check">
                                            <input class="form-check-input chk-legal-req" type="checkbox" id="chkPrivacidadLegal" onchange="evaluarAceptacionLegal()">
                                            <label class="form-check-label fw-bold text-dark small cursor-pointer" for="chkPrivacidadLegal">
                                                He leído y acepto el Aviso de Privacidad Integral
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center pt-2">
                            <button type="button" id="btnConfirmarLegal" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow btn-lg text-uppercase" disabled onclick="confirmarAceptacionLegal()">
                                <i class="fa-solid fa-circle-check me-2"></i> He leído y estoy de acuerdo
                            </button>
                        </div>
                    </div>
                </div>
            }

                <div id="cardNuevoRegistro" class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5 @(iniciarFormularioAbierto ? "" : "oculto")">
                    <div class="card-header bg-dark text-white p-3 ps-4 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user-plus me-2 text-warning"></i> Nuevo Registro</h6>
                        @if (tieneHistorial && esGrupal)
                        {
                            <button type="button" class="btn-close btn-close-white" onclick="cancelarNuevoRegistro()"></button>
                        }
                    </div>

                    <div class="card-body p-3 p-md-4">
                        <form method="post" action="@Url.Action("ProcesarRegistro")" id="formRegistro">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id_Evento" value="@idEvento" />
                            <input type="hidden" name="CostoUnitario" value="@costoBase" id="hdnCosto" />

                            @if (cupoMax > 0)
                            {
                                <div class="text-end mb-3"><span class="badge bg-info text-dark">@lugaresDisponibles lugares disponibles</span></div>
                            }

                            <div id="contenedorAsistentes"></div>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top flex-wrap gap-3">
                                @if (esGrupal)
                                {
                                    <button type="button" id="btnAgregarOtro" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="agregarFila()"><i class="fa-solid fa-plus me-1"></i> Otro</button>
                                }
                                else
                                {
                                    <div></div>
                                }

                                <div class="text-end w-100 w-md-auto">
                                    <h3 class="fw-bold text-dark mb-2" id="lblTotal">$0.00</h3>
                                    <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold shadow w-100 w-md-auto">Registrar</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else if (!tieneHistorial && !hayCupo && !eventoBloqueado)
            {
                <div class="alert alert-secondary text-center p-4 mt-4"><h5>Cupo Lleno</h5></div>
            }
        </div>
    </div>
</div>

