    // --- ACTUALIZACIÓN DINÁMICA DE EXTRAS EN MODAL EDITAR ---
    function actualizarExtrasModalEdit(selElement) {
        var idSubtipo = selElement.value ? parseInt(selElement.value) : null;
        var idAsistente = parseInt(document.getElementById('edit_id').value) || 0;
        var datos = listaRegistrados.find(x => x.Id_Asistente === idAsistente);
        renderizarExtrasModalEdit(datos, idSubtipo);
    }

    function renderizarExtrasModalEdit(datos, idSubtipo) {
        var contExtras = document.getElementById('contenedorExtrasEdit');
        var seccExtras = document.getElementById('seccionExtrasEdit');
        if (!contExtras) return;

        contExtras.innerHTML = '';
        var extrasCompatibles = (catalogoExtras || []).filter(e => e.Activo && (!e.Id_Subtipo || e.Id_Subtipo == idSubtipo));

        if (extrasCompatibles.length === 0) {
            if (seccExtras) seccExtras.classList.add('d-none');
        } else {
            if (seccExtras) seccExtras.classList.remove('d-none');
            extrasCompatibles.forEach((ext, idx) => {
                var comprado = (datos && datos.ProductosExtra ? datos.ProductosExtra : []).find(p => p.Id_ProductoExtra === ext.Id_ProductoExtra);
                var cantActual = comprado ? comprado.CantidadComprada : 0;
                var cantPagada = comprado ? comprado.CantidadPagada : 0;
                var cMin = Math.max(cantPagada, ext.Cantidad_Minima || 0);
                var cMax = ext.Cantidad_Maxima > 0 ? ext.Cantidad_Maxima : 1;

                var itemDiv = document.createElement('div');
                itemDiv.className = 'p-2 bg-light rounded border d-flex justify-content-between align-items-center flex-wrap gap-2';

                var infoDiv = document.createElement('div');
                infoDiv.innerHTML = `
                    <div class="fw-bold small text-dark">${ext.Nombre_Producto}</div>
                    ${ext.Descripcion ? `<div class="text-secondary mb-1 text-break" style="font-size: 0.78rem; line-height: 1.35; white-space: normal;">${ext.Descripcion}</div>` : ''}
                    <div class="text-muted" style="font-size: 0.75rem;">
                        $${ext.Precio.toLocaleString('en-US', { minimumFractionDigits: 2 })} c/u
                        ${cantPagada > 0 ? `<span class="badge bg-success bg-opacity-10 text-success border border-success ms-1"><i class="fa-solid fa-lock me-1"></i>${cantPagada} pagada${cantPagada > 1 ? 's' : ''}</span>` : ''}
                    </div>
                `;
                itemDiv.appendChild(infoDiv);

                var controlDiv = document.createElement('div');
                controlDiv.className = 'd-flex align-items-center gap-1';

                var hdnId = document.createElement('input');
                hdnId.type = 'hidden';
                hdnId.name = `Asistentes[0].ProductosExtra[${idx}].Id_ProductoExtra`;
                hdnId.value = ext.Id_ProductoExtra;
                controlDiv.appendChild(hdnId);

                if (cMax === 1) {
                    if (cantPagada >= 1) {
                        controlDiv.innerHTML += `
                            <input type="hidden" name="Asistentes[0].ProductosExtra[${idx}].Cantidad" value="1" />
                            <span class="badge bg-success p-2"><i class="fa-solid fa-check me-1"></i>Incluido (Pagado)</span>
                        `;
                    } else {
                        var sel = document.createElement('select');
                        sel.name = `Asistentes[0].ProductosExtra[${idx}].Cantidad`;
                        sel.className = 'form-select form-select-sm';
                        sel.style.width = '100px';
                        sel.innerHTML = `
                            <option value="0" ${cantActual === 0 ? 'selected' : ''}>No</option>
                            <option value="1" ${cantActual >= 1 ? 'selected' : ''}>Sí</option>
                        `;
                        controlDiv.appendChild(sel);
                    }
                } else {
                    var btnMinus = document.createElement('button');
                    btnMinus.type = 'button';
                    btnMinus.className = 'btn btn-sm btn-outline-secondary px-2 py-1';
                    btnMinus.innerHTML = '<i class="fa-solid fa-minus"></i>';

                    var inpCant = document.createElement('input');
                    inpCant.type = 'number';
                    inpCant.name = `Asistentes[0].ProductosExtra[${idx}].Cantidad`;
                    inpCant.value = cantActual;
                    inpCant.min = cMin;
                    inpCant.max = cMax;
                    inpCant.readOnly = true;
                    inpCant.className = 'form-control form-control-sm text-center fw-bold';
                    inpCant.style.width = '55px';

                    var btnPlus = document.createElement('button');
                    btnPlus.type = 'button';
                    btnPlus.className = 'btn btn-sm btn-outline-secondary px-2 py-1';
                    btnPlus.innerHTML = '<i class="fa-solid fa-plus"></i>';

                    if (cantActual <= cMin) btnMinus.disabled = true;
                    if (cantActual >= cMax) btnPlus.disabled = true;

                    btnMinus.onclick = function() {
                        var val = parseInt(inpCant.value) || 0;
                        if (val > cMin) {
                            inpCant.value = val - 1;
                            btnPlus.disabled = false;
                            if (val - 1 <= cMin) btnMinus.disabled = true;
                        }
                    };

                    btnPlus.onclick = function() {
                        var val = parseInt(inpCant.value) || 0;
                        if (val < cMax) {
                            inpCant.value = val + 1;
                            btnMinus.disabled = false;
                            if (val + 1 >= cMax) btnPlus.disabled = true;
                        }
                    };

                    controlDiv.appendChild(btnMinus);
                    controlDiv.appendChild(inpCant);
                    controlDiv.appendChild(btnPlus);
                }

                itemDiv.appendChild(controlDiv);
                contExtras.appendChild(itemDiv);
            });
        }
    }

    // --- MODAL EDICIÓN CON CANDADO ---
    function prepararEdicion(idAsistente) {
        // Buscar datos en el JSON local
        var datos = listaRegistrados.find(x => x.Id_Asistente === idAsistente);
        if(!datos) return;

        document.getElementById('edit_id').value = datos.Id_Asistente;
        document.getElementById('edit_nombre').value = datos.NombreCompleto;
        document.getElementById('edit_edad').value = datos.Edad;
        
        var elGrupo = document.getElementById('edit_etiqueta');
        if(elGrupo) elGrupo.value = datos.EtiquetaGrupo || 'General';

        // --- NUEVA LÓGICA DE BLOQUEO DE GÉNERO ---
        var selGen = document.getElementById('edit_genero');
        var hdnGen = document.getElementById('hdn_edit_genero');
        var alertGen = document.getElementById('alertBloqueoGenero');

        if(selGen) {
            selGen.value = datos.Genero;
            // Evaluamos si está asignado a un alojamiento
            if (datos.EstaAsignadoAlojamiento) {
                selGen.disabled = true;
                if(hdnGen) {
                    hdnGen.value = datos.Genero;
                    hdnGen.disabled = false; // Activamos el hidden para que se envíe el dato
                }
                if(alertGen) alertGen.classList.remove('d-none');
            } else {
                selGen.disabled = false;
                if(hdnGen) hdnGen.disabled = true;
                if(alertGen) alertGen.classList.add('d-none');
            }
        }
        // -----------------------------------------

        // --- GESTIÓN DE MODALIDAD CON CANDADO DE PAGO ---
        var selSub = document.getElementById('edit_subtipo');
        var hdnSub = document.getElementById('hdn_edit_subtipo');
        var alertBlock = document.getElementById('alertBloqueo');

        // Si ya tiene pagos completados o pagos en revisión/comprobante
        var tienePagosModalidad = (datos.PagosRealizados > 0) || datos.EstaBloqueado || (datos.EsPagado);

        if (selSub) {
            selSub.value = datos.IdSubtipo || "";
            if (tienePagosModalidad) {
                selSub.disabled = true;
                if (hdnSub) {
                    hdnSub.value = datos.IdSubtipo || "";
                    hdnSub.disabled = false; // Envía el valor bloqueado
                }
                if (alertBlock) alertBlock.classList.remove('d-none');
            } else {
                selSub.disabled = false;
                if (hdnSub) {
                    hdnSub.disabled = true;
                }
                if (alertBlock) alertBlock.classList.add('d-none');
            }
        }

        // Renderizar los extras compatibles con la modalidad actual
        renderizarExtrasModalEdit(datos, datos.IdSubtipo);

        // Llenar respuestas
        var inputs = document.querySelectorAll('.inp-resp-edit');
        inputs.forEach(i => i.value = '');
        if (datos.Respuestas && datos.Respuestas.length > 0) {
            datos.Respuestas.forEach(r => {
                var input = document.querySelector(`.inp-resp-edit[data-idpreg="${r.Id_Pregunta}"]`);
                if (input) input.value = r.Valor;
            });
        }

        var myModal = new bootstrap.Modal(document.getElementById('modalEditar')); myModal.show();
    }

