    function inicializarFilas() {
        if(asistentesPropuestos && asistentesPropuestos.length > 0) {
            asistentesPropuestos.forEach(p => insertarFilaEnDOM(p.NombreCompleto, p.Edad, p.Genero, p.EtiquetaGrupo));
        } else {
            agregarFila();
        }
    }

    function crearTarjetaCompositeQR(qrCanvas, nombre, esPagado, subtexto) {
        var width = 380;
        var height = 460;
        var canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        var ctx = canvas.getContext('2d');

        // Fondo Blanco
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, width, height);

        // Borde elegante exterior
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 4;
        ctx.strokeRect(2, 2, width - 4, height - 4);

        // Header banner tenue (verde o rojo)
        ctx.fillStyle = esPagado ? '#F0FDF4' : '#FEF2F2';
        ctx.fillRect(4, 4, width - 8, 80);

        // Insignia Pequeña: ✔️ o ❌
        ctx.save();
        if (esPagado) {
            ctx.fillStyle = '#16A34A';
            ctx.beginPath();
            ctx.arc(36, 44, 20, 0, 2 * Math.PI);
            ctx.fill();

            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 22px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('✓', 36, 44);
        } else {
            ctx.fillStyle = '#DC2626';
            ctx.beginPath();
            ctx.arc(36, 44, 20, 0, 2 * Math.PI);
            ctx.fill();

            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 20px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('✕', 36, 44);
        }
        ctx.restore();

        // Nombre Completo de la persona (Multilínea sin recortar)
        ctx.fillStyle = '#0F172A';
        var fontSize = 15;
        var nombreTexto = (nombre || 'ASISTENTE').trim();
        if (nombreTexto.length > 32) fontSize = 12;
        else if (nombreTexto.length > 24) fontSize = 13;

        ctx.font = 'bold ' + fontSize + 'px sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';

        var palabras = nombreTexto.split(' ');
        var linea1 = '';
        var linea2 = '';
        var maxAnchoTexto = 295;

        for (var i = 0; i < palabras.length; i++) {
            var prueba = linea1 + (linea1 ? ' ' : '') + palabras[i];
            if (ctx.measureText(prueba).width <= maxAnchoTexto) {
                linea1 = prueba;
            } else {
                linea2 = palabras.slice(i).join(' ');
                break;
            }
        }

        if (linea2) {
            ctx.fillText(linea1, 68, 14);
            ctx.fillText(linea2, 68, 14 + fontSize + 2);
            ctx.font = 'bold 11px sans-serif';
            ctx.fillStyle = esPagado ? '#15803D' : '#B91C1C';
            ctx.fillText(esPagado ? '✓ PAGADO / LIQUIDADO' : '✕ PAGO PENDIENTE', 68, 14 + (fontSize + 2) * 2 + 2);
        } else {
            ctx.fillText(linea1, 68, 20);
            ctx.font = 'bold 12px sans-serif';
            ctx.fillStyle = esPagado ? '#15803D' : '#B91C1C';
            ctx.fillText(esPagado ? '✓ PAGADO / LIQUIDADO' : '✕ PAGO PENDIENTE', 68, 46);
        }

        // Línea separadora
        ctx.strokeStyle = '#E2E8F0';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(10, 84);
        ctx.lineTo(width - 10, 84);
        ctx.stroke();

        // Dibujar QR en el centro (240x240 px)
        var qrSize = 240;
        var qrX = (width - qrSize) / 2;
        var qrY = 100;
        ctx.drawImage(qrCanvas, qrX, qrY, qrSize, qrSize);

        // Pie de página
        ctx.fillStyle = '#64748B';
        ctx.font = '12px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        if (subtexto) {
            ctx.fillText(subtexto, width / 2, height - 26);
        }
        ctx.font = 'bold 11px sans-serif';
        ctx.fillStyle = '#334155';
        ctx.fillText('CÓDIGO DE ACCESO OFICIAL - MINISTERIO CORBÁN', width / 2, height - 10);

        return canvas;
    }

    function mostrarQR(tokenExterno, nombre, esPagado) {
        var qrContainer = document.getElementById('qrCodeContainer');
        qrContainer.innerHTML = '';
        
        var tempDiv = document.createElement('div');
        tempDiv.style.display = 'none';
        document.body.appendChild(tempDiv);

        var urlCompleto = window.location.origin + '@Url.Action("Pagar", "Eventos")' + '?token=' + tokenExterno;

        new QRCode(tempDiv, {
            text: urlCompleto,
            width: 250,
            height: 250,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.H
        });

        setTimeout(() => {
            var rawCanvas = tempDiv.querySelector('canvas');
            var btnDownload = document.getElementById('btnDownloadQR');
            if (rawCanvas) {
                var finalCanvas = crearTarjetaCompositeQR(rawCanvas, nombre, !!esPagado, 'CÓDIGO INDIVIDUAL');
                finalCanvas.style.maxWidth = '100%';
                finalCanvas.style.height = 'auto';
                finalCanvas.style.borderRadius = '16px';
                finalCanvas.style.boxShadow = '0 4px 16px rgba(0,0,0,0.08)';

                qrContainer.innerHTML = '';
                qrContainer.appendChild(finalCanvas);
                
                btnDownload.href = finalCanvas.toDataURL("image/png");
                btnDownload.download = (esPagado ? 'QR_PAGADO_' : 'QR_PENDIENTE_') + nombre.replace(/ /g, '_') + '.png';
                btnDownload.style.display = 'inline-block';
            } else {
                btnDownload.style.display = 'none';
            }
            if (tempDiv.parentNode) tempDiv.parentNode.removeChild(tempDiv);
        }, 250);

        new bootstrap.Modal(document.getElementById('modalQR')).show();
    }

    function evaluarAceptacionLegal() {
        const terminos = document.getElementById('chkTerminosLegal')?.checked || false;
        const privacidad = document.getElementById('chkPrivacidadLegal')?.checked || false;
        const btn = document.getElementById('btnConfirmarLegal');
        if (btn) {
            btn.disabled = !(terminos && privacidad);
        }
    }

    function confirmarAceptacionLegal() {
        sessionStorage.setItem('legalesAceptados_' + @idEvento, 'true');
        const cardLegal = document.getElementById('cardAceptacionLegal');
        if (cardLegal) cardLegal.classList.add('d-none');
        
        const cardRegistro = document.getElementById('cardNuevoRegistro');
        if (cardRegistro) cardRegistro.classList.remove('oculto');
    }

    window.addEventListener('load', function() {
        const tieneHistorial = @(tieneHistorial.ToString().ToLower());
        const iniciarFormularioAbierto = @(iniciarFormularioAbierto.ToString().ToLower());
        const aceptados = sessionStorage.getItem('legalesAceptados_' + @idEvento) === 'true';
        
        const cardLegal = document.getElementById('cardAceptacionLegal');
        const cardRegistro = document.getElementById('cardNuevoRegistro');

        if (cardLegal) {
            if (aceptados || tieneHistorial) {
                cardLegal.classList.add('d-none');
                if (cardRegistro && iniciarFormularioAbierto) {
                    cardRegistro.classList.remove('oculto');
                }
            } else {
                cardLegal.classList.remove('d-none');
                if (cardRegistro) {
                    cardRegistro.classList.add('oculto');
                }
            }
        }

        // Inicializar tooltips de Bootstrap
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });

    function abrirLectorPDF(titulo, url) {
        const esMovil = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
        if (esMovil) {
            window.open(url, '_blank');
        } else {
            document.getElementById('pdfModalTitle').textContent = titulo;
            document.getElementById('pdfIframe').src = url;
            document.getElementById('btnPdfDownloadModal').href = url;
            new bootstrap.Modal(document.getElementById('modalLectorPDF')).show();
        }
    }
</script>

    function mostrarAlertaEncuestaPendiente(nombre, linkEncuesta) {
        var fullUrl = window.location.origin + linkEncuesta;
        document.getElementById('modalEncuestaNombreAsistente').innerText = nombre;
        document.getElementById('modalEncuestaBtnResponder').href = fullUrl;
        document.getElementById('modalEncuestaBtnCopiar').onclick = function() {
            navigator.clipboard.writeText(fullUrl).then(function() {
                if (typeof mostrarMensaje === 'function') mostrarMensaje('Enlace Copiado', 'Link de encuesta para <b>' + nombre + '</b> copiado.', 'exito');
                else Swal.fire({ icon: 'success', title: 'Copiado', text: 'Enlace copiado al portapapeles' });
            });
        };
        new bootstrap.Modal(document.getElementById('modalEncuestaPendiente')).show();
    }

    function copiarLinkEncuesta(linkRelativo, nombre) {
        var fullUrl = window.location.origin + linkRelativo;
        navigator.clipboard.writeText(fullUrl).then(function() {
            if (typeof mostrarMensaje === 'function') mostrarMensaje('Enlace Copiado', 'Link de encuesta para <b>' + nombre + '</b> copiado.', 'exito');
            else Swal.fire({ icon: 'success', title: 'Copiado', text: 'Enlace copiado al portapapeles' });
        }).catch(function() {
            prompt('Copia este enlace de encuesta para ' + nombre + ':', fullUrl);
        });
    }

