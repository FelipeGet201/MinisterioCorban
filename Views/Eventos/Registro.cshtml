    function calcularTotal() {
        var total = 0;
        var filas = document.querySelectorAll('.fila-persona');
        filas.forEach(row => {
            var sel = row.querySelector('.sel-subtipo');
            if(sel) {
                var opt = sel.options[sel.selectedIndex];
                total += parseFloat(opt.getAttribute('data-costo') || 0);
            } else {
                total += costoBaseGeneral;
            }

            // Sumar extras
            var extras = row.querySelectorAll('.inp-cant-extra');
            extras.forEach(ext => {
                let cant = parseInt(ext.value) || 0;
                let precio = parseFloat(ext.getAttribute('data-precio') || 0);
                total += cant * precio;
            });
        });
        var lbl = document.getElementById('lblTotal'); if(lbl) lbl.innerText = '$' + total.toFixed(2);
    }

    function actualizarExtrasForm(selElement) {
        var fila = selElement.closest('.fila-persona');
        if (!fila) return;
        var subtipoId = selElement.value;
        var itemsExtra = fila.querySelectorAll('.item-extra-registro');
        itemsExtra.forEach(item => {
            var reqSub = item.getAttribute('data-subtipo');
            if (!reqSub || reqSub === subtipoId) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
                var inp = item.querySelector('.inp-cant-extra');
                if (inp) inp.value = 0;
                var btnGroup = item.querySelector('.btn-group-extra');
                if (btnGroup) {
                    var btnNo = btnGroup.querySelector('.btn-no-extra');
                    var btnSi = btnGroup.querySelector('.btn-si-extra');
                    if (btnNo) btnNo.className = 'btn btn-secondary btn-no-extra';
                    if (btnSi) btnSi.className = 'btn btn-outline-success btn-si-extra';
                }
            }
        });
    }

    // Delegación para botones +/- de extras
    document.addEventListener('click', function(e) {
        var btnNo = e.target.closest('.btn-no-extra');
        var btnSi = e.target.closest('.btn-si-extra');
        
        if (btnNo || btnSi) {
            var container = (btnNo || btnSi).closest('.card-body');
            var inp = container.querySelector('.inp-cant-extra');
            var btnGroup = container.querySelector('.btn-group-extra');
            var localBtnNo = btnGroup.querySelector('.btn-no-extra');
            var localBtnSi = btnGroup.querySelector('.btn-si-extra');

            if (btnNo) {
                localBtnNo.className = 'btn btn-secondary btn-no-extra';
                localBtnSi.className = 'btn btn-outline-success btn-si-extra';
                inp.value = 0;
            } else if (btnSi) {
                localBtnNo.className = 'btn btn-outline-secondary btn-no-extra';
                localBtnSi.className = 'btn btn-success btn-si-extra';
                inp.value = 1;
            }
            calcularTotal();
            return;
        }

        if (e.target.closest('.btn-mas-extra') || e.target.closest('.btn-menos-extra')) {
            var isMas = e.target.closest('.btn-mas-extra') != null;
            var container = e.target.closest('.input-group');
            var inp = container.querySelector('.inp-cant-extra');
            var current = parseInt(inp.value) || 0;
            var min = parseInt(inp.getAttribute('min')) || 0;
            var max = parseInt(inp.getAttribute('max')) || 999;
            
            if (isMas && current < max) {
                inp.value = current + 1;
                calcularTotal();
            } else if (!isMas && current > min) {
                inp.value = current - 1;
                calcularTotal();
            }
        }
    });

    function reindexar() {
        var filas = document.querySelectorAll('.fila-persona');
        filas.forEach((fila, i) => { fila.querySelectorAll('input, select').forEach(input => { if(input.name) input.name = input.name.replace(/Asistentes\[\d+\]/, `Asistentes[${i}]`); }); });
        calcularTotal();
    }

