@model RedAJP.Models.EncuestaResponderViewModel
@{
    Layout = "Principal";
    ViewData["Title"] = Model.Titulo;
}

<link href="~/lib/select2/select2.min.css" rel="stylesheet" />

<style>
    /* Estilos Glassmorphism */
    .survey-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 20px 40px rgba(0, 43, 54, 0.15);
        border-radius: 24px;
        padding: 2.5rem;
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        position: relative;
        z-index: 10;
        display: none;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.4s ease;
    }

        .survey-card.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

    /* Barra Progreso */
    .progress-track {
        max-width: 600px;
        margin: 0 auto 20px;
        height: 6px;
        background: rgba(0,0,0,0.1);
        border-radius: 10px;
        overflow: hidden;
        transition: opacity 0.3s;
    }

    .progress-fill {
        height: 100%;
        background: #ffb74d;
        width: 0%;
        transition: width 0.4s;
    }

    /* Controles */
    .btn-option {
        display: block;
        width: 100%;
        padding: 15px;
        margin-bottom: 10px;
        background: #fff;
        border: 2px solid #e0e0e0;
        border-radius: 15px;
        color: var(--text-muted);
        text-align: left;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-option:hover {
            background: #f8f9fa;
            border-color: #ced4da;
        }

        .btn-option.selected {
            background: rgba(140, 35, 35, 0.1);
            border-color: var(--primary);
            color: var(--primary-dark);
        }

    /* Estrellas y Emojis */
    .rating-group {
        font-size: 2.5rem;
        text-align: center;
        color: #cfd8dc;
        cursor: pointer;
    }

    .star.active {
        color: #ffca28;
    }

    .star:hover {
        transform: scale(1.2);
        transition: transform 0.2s;
    }

    .emoji-display {
        font-size: 4rem;
        display: block;
        text-align: center;
        margin-bottom: 1rem;
        animation: rubberBand 1s;
    }

    /* Rangos */
    .custom-range {
        width: 100%;
        accent-color: var(--primary);
        height: 8px;
        cursor: pointer;
    }

    /* Input Fecha */
    input[type="date"] {
        display: block;
        width: 100%;
        padding: 0.5rem;
        font-size: 1.25rem;
        text-align: center;
        border-radius: 12px;
        border: 2px solid #e0e0e0;
        color: var(--text-main);
    }

    /* --- EFECTO: BURBUJAS DE CRISTAL (Versión Suave) --- */
    .nautic-particle {
        position: fixed;
        pointer-events: none;
        border-radius: 50%;
        z-index: 9999;
        /* CAMBIO CLAVE: Transparencia y Mezcla */
        opacity: 0.6;
        /* Hacemos que sean translúcidas */
        box-shadow: inset 0 0 6px rgba(255, 255, 255, 0.4);
        /* Brillo interior */
        backdrop-filter: blur(1px);
        /* Un toque de desenfoque */
        border: 1px solid rgba(255,255,255,0.3);
        /* Borde sutil de burbuja */

        animation: bubble-float 1.2s ease-out forwards;
        /* Un poco más lento para ser elegante */
    }

    @@keyframes bubble-float {
        0% {
            opacity: 0.6;
            transform: translate(0, 0) scale(0.5); /* Empiezan pequeñas */
        }

        100% {
            opacity: 0;
            /* Suben más (efecto burbuja real) y crecen un poco */
            transform: translate(var(--tx), calc(var(--ty) - 80px)) scale(1.2);
        }
    }

    /* --- ESTILOS SELECT2 PARA INTEGRACIÓN CON BOOTSTRAP 5 --- */
    .select2-container .select2-selection--single {
        height: calc(1.5em + 1rem + 2px) !important;
        border: 2px solid #dee2e6 !important;
        border-radius: 12px !important;
        padding: 0.375rem 0.75rem;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        background-color: #fff;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 100% !important;
        right: 15px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: var(--text-main) !important;
        padding-left: 0 !important;
        line-height: normal !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #6c757d !important;
    }
</style>

<div class="container py-5 fade-in">

@if (Model.RequiereClaveManual && !Model.IdAsistenteEvento.HasValue)
{
    <div class="survey-card active" style="display: block; opacity: 1; transform: translateY(0);">
        <div class="text-center mb-4">
            <div class="bg-warning bg-opacity-25 text-warning d-inline-flex p-3 rounded-circle mb-3">
                <i class="fa-solid fa-id-card fa-3x"></i>
            </div>
            <h2 class="fw-bold text-dark">Clave de Asistente Requerida</h2>
            <p class="text-muted">
                Esta encuesta corresponde al evento <strong>@Model.Titulo</strong> y es un requisito personal por asistente para emitir tu código QR y comprobantes.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorClave))
        {
            <div class="alert alert-danger border-0 rounded-4 p-3 mb-3 small d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-exclamation fs-5"></i>
                <div>@Model.ErrorClave</div>
            </div>
        }

        <div class="bg-light p-4 rounded-4 border mb-4">
            <form method="get" action="@Url.Action("Responder", "Encuestas", new { clave = Model.ClaveUrl ?? ViewContext.RouteData.Values["clave"] })">
                <input type="hidden" name="retorno" value="@Model.Retorno" />
                <input type="hidden" name="evt" value="@Model.IdEventoRetorno" />
                <div class="mb-3 text-start">
                    <label class="form-label fw-bold text-secondary small">Ingresa tu Número de Asistente:</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-2 text-muted"><i class="fa-solid fa-hashtag"></i></span>
                        <input type="number" name="asis" class="form-control border-2 fw-bold text-dark" placeholder="Ej. 42" required autofocus />
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="fa-solid fa-circle-info me-1"></i> Puedes consultar este número en tu comprobante o solicitarlo a la persona que realizó tu inscripción.
                    </small>
                </div>
                <button type="submit" class="btn btn-warning w-100 py-3 rounded-pill fw-bold text-dark shadow-sm">
                    Ingresar a la Encuesta <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
            </form>
        </div>

        @if (!string.IsNullOrEmpty(Model.Retorno))
        {
            <div class="text-center">
                <a href="@Url.Action("Pagar", "Eventos", new { token = Model.Retorno })" class="text-decoration-none small text-muted fw-bold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Regresar al Estado de Cuenta
                </a>
            </div>
        }
    </div>
}
else
{

    <div class="progress-track" id="trackBar"><div class="progress-fill" id="progressBar"></div></div>

    <form id="surveyForm" method="post" action="@Url.Action("Finalizar")" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdEncuesta" value="@Model.Id" />
        <input type="hidden" name="ClaveUrl" value="@ViewContext.RouteData.Values["clave"]" />
        <input type="hidden" name="evt" value="@Model.IdEventoRetorno" />
        <input type="hidden" name="IdAsistenteEvento" value="@Model.IdAsistenteEvento" />
        <input type="hidden" name="TokenAsistente" value="@Model.TokenAsistente" />
        <input type="hidden" name="retorno" value="@Model.Retorno" />

        <div class="survey-card active" id="step-0">
            <div class="text-center mb-4">
                <h1 class="fw-bold text-dark">@Model.Titulo</h1>
                <p class="text-muted fs-5">@Model.Descripcion</p>
            </div>

            @if (Model.IdAsistenteEvento.HasValue)
            {
                <div class="alert alert-primary border-0 rounded-4 text-center mb-4 py-2">
                    <i class="fa-solid fa-user-check me-2"></i>
                    Asistente: <strong>@(string.IsNullOrEmpty(Model.NombreAsistente) ? $"#{Model.IdAsistenteEvento}" : Model.NombreAsistente)</strong>
                </div>
            }

            @if (Model.PedirDatosIdentidad)
            {
                <div class="bg-light p-4 rounded-4 border mb-4">
                    <h6 class="fw-bold text-primary text-uppercase small mb-3">Tus Datos</h6>
                    <input type="text" name="NombreExterno" class="form-control form-control-lg mb-2" placeholder="Nombre Completo" required>
                    <input type="email" name="EmailExterno" class="form-control form-control-lg" placeholder="Correo Electrónico" required>
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 rounded-pill text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.NombreUsuarioLogueado))
                    {
                        if (Model.EsAnonima)
                        {
                            <span>Hola <strong>@Model.NombreUsuarioLogueado</strong>, te invitamos a responder esta encuesta anónima.</span>
                        }
                        else
                        {
                            <span>Hola, <strong>@Model.NombreUsuarioLogueado</strong></span>
                        }
                    }
                    else
                    {
                        <span>¡Hola!, Te invitamos a responder esta encuesta.</span>
                    }
                </div>
            }

            @if (Model.SolicitarIglesia)
            {
                if (ViewBag.IdIglesiaPreasignada != null)
                {
                    <input type="hidden" name="IdIglesiaSeleccionada" value="@ViewBag.IdIglesiaPreasignada" required />
                }
                else
                {
                    <div class="bg-light p-4 rounded-4 border mb-4 text-start" id="contenedorSelectIglesia">
                        <h6 class="fw-bold text-primary text-uppercase small mb-3"><i class="fa-solid fa-church me-2"></i>¿A qué iglesia perteneces?</h6>
                        <select id="selectIglesia" name="IdIglesiaSeleccionada" class="form-select form-select-lg border-2" style="width: 100%;" required>
                            <option value=""></option>
                            @if (ViewBag.Iglesias != null)
                            {
                                foreach (var ig in ViewBag.Iglesias)
                                {
                                    string txtLocalidad = !string.IsNullOrEmpty(ig.Localidad) ? $", {ig.Localidad}" : "";
                                    <option value="@ig.Id">@ig.Nombre - @ig.Municipio@txtLocalidad</option>
                                }
                            }
                        </select>
                        <div class="text-center mt-2" id="contenedorLinkFaltaIglesia">
                            <a href="javascript:void(0)" class="text-muted small text-decoration-underline fw-bold" onclick="toggleFaltaIglesia(true)">
                                ¿Tu iglesia no aparece en la lista?
                            </a>
                        </div>
                    </div>
                }

                <!-- Mensaje que bloquea el avance -->
                <div id="msgFaltaIglesia" class="alert border-0 rounded-4 p-4 text-center mb-4 shadow-sm mx-auto" style="display: none; background-color: #fff3cd; color: #856404;">
                    <div class="mb-3 position-relative d-inline-block">
                        <i class="fa-solid fa-church fa-2x text-warning"></i>
                        <i class="fa-solid fa-circle-exclamation text-warning bg-white rounded-circle" style="position: absolute; bottom: -5px; right: -10px; font-size: 1.2rem;"></i>
                    </div>
                    <h6 class="fw-bold mb-2">¿Tu iglesia aún no está registrada en la página?</h6>
                    <p class="small mb-3">
                        Por favor, <strong>comunícate con un directivo</strong> para solicitar que la registren. Una vez dada de alta, podrás volver para continuar con tu encuesta.
                    </p>
                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill text-dark fw-bold px-4 shadow-sm" onclick="toggleFaltaIglesia(false)">
                        <i class="fa-solid fa-arrow-left me-1"></i> Entendido, Volver
                    </button>
                </div>
                <!-- =============================================== -->
            }

            <div class="d-grid" id="contenedorBtnComenzar">
                <button type="button" class="btn btn-dark rounded-pill py-3 fw-bold shadow hover-scale" onclick="nextStep(0)">Comenzar</button>
            </div>
        </div>

        @{
            int i = 0;
        }
        @foreach (var p in Model.Preguntas)
        {
            i++;
            <div class="survey-card" id="step-@i">
                <div class="text-center mb-4">
                    <span class="badge bg-light text-muted border mb-2">Pregunta @i de @Model.Preguntas.Count</span>
                    @if (p.Requerida)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary ms-1 border border-primary border-opacity-25" style="font-size:0.7rem;"><i class="fa-solid fa-asterisk"></i> Obligatoria</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1 opacity-50" style="font-size:0.7rem;">Opcional</span>
                    }
                    <h3 class="fw-bold text-dark mt-2">@p.Texto</h3>
                </div>

                <div class="mb-5">
                    <input type="hidden" name="R_@p.Id_Pregunta" class="val-input" @(p.Requerida ? "required-logic" : "")>

                    @* --- AQUÍ AGREGAMOS LA FECHA --- *@
                    @if (p.Tipo == "Fecha")
                    {
                        <div class="d-flex justify-content-center">
                            <input type="date" class="form-control form-control-lg border-2" oninput="setVal(this, this.value)" style="max-width: 300px;">
                        </div>
                    }
                    else if (p.Tipo == "Texto")
                    {
                        <input type="text" class="form-control form-control-lg border-2" placeholder="Escribe aquí..." oninput="setVal(this, this.value)">
                    }
                    else if (p.Tipo == "Parrafo")
                    {
                        <textarea class="form-control form-control-lg border-2" rows="4" placeholder="Escribe tu respuesta..." oninput="setVal(this, this.value)"></textarea>
                    }
                    else if (p.Tipo == "Opcion" || p.Tipo == "SiNo")
                    {
                        var opts = p.Tipo == "SiNo" ? new string[] { "Sí", "No" } : p.Configuracion.Split('|');
                        foreach (var op in opts)
                        {
                            <button type="button" class="btn-option" onclick="selectOption(this, '@op')">@op</button>
                        }
                    }
                    else if (p.Tipo == "Casillas")
                    {
                        var opts = p.Configuracion.Split('|');
                        foreach (var op in opts)
                        {
                            <button type="button" class="btn-option" onclick="toggleCheckbox(this, '@op')">
                                <i class="fa-regular fa-square me-2 check-icon"></i> @op
                            </button>
                        }
                    }
                    else if (p.Tipo == "RatingStar")
                    {
                        <div class="rating-group">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <i class="fa-solid fa-star star" onclick="setRating(this, @s)"></i>
                            }
                        </div>
                    }
                    else if (p.Tipo == "RatingEmoji")
                    {
                        <div class="text-center">
                            <span class="emoji-display" id="emo_@i">😐</span>
                            <input type="range" class="custom-range" min="1" max="5" step="1" value="3" oninput="updateEmoji(this.value, 'emo_@i', this)">
                        </div>
                    }
                    else if (p.Tipo == "RangoNumerico")
                    {
                        var parts = p.Configuracion?.Split('|') ?? new string[] { "0", "10", "Min", "Max" };
                        int min = 0, max = 10;
                        string lmin = "Min", lmax = "Max";
                        if (parts.Length >= 2) { int.TryParse(parts[0], out min); int.TryParse(parts[1], out max); }
                        if (parts.Length >= 4) { lmin = parts[2]; lmax = parts[3]; }

                        <div class="px-3">
                            <div class="d-flex justify-content-between h4 mb-3 fw-bold text-primary">
                                <span>@min</span><span id="lbl_@i">@((min + max) / 2)</span><span>@max</span>
                            </div>
                            <input type="range" class="custom-range" min="@min" max="@max" value="@((min + max) / 2)" oninput="document.getElementById('lbl_@i').innerText=this.value; setVal(this, this.value)">
                            <div class="d-flex justify-content-between small text-muted text-uppercase fw-bold mt-2">
                                <span>@lmin</span><span>@lmax</span>
                            </div>
                        </div>
                        <script>document.addEventListener("DOMContentLoaded", function(){ setVal(document.getElementById('lbl_@i'), '@((min + max) / 2)'); });</script>
                    }
                    else if (p.Tipo == "Archivo")
                    {
                        // Convertimos ".pdf|.jpg" en ".pdf,.jpg" para el atributo accept del navegador
                        var acceptAttr = p.Configuracion?.Replace("|", ",");
                        <div class="text-center p-4 border-dashed rounded-4 bg-light shadow-sm mb-3" style="border: 2px dashed #dee2e6;">
                            <i class="fa-solid fa-file-arrow-up fa-3x text-muted mb-3"></i>
                            <h6 class="fw-bold text-dark">Sube tu archivo</h6>
                            <p class="small text-muted">Formatos permitidos: @acceptAttr.ToUpper()</p>

                            <input type="file" name="File_@p.Id_Pregunta" class="d-none file-input-real"
                                   id="file_@p.Id_Pregunta"
                                   accept="@acceptAttr"
                                   onchange="validarArchivo(this, @p.Id_Pregunta)">

                            <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold"
                                    onclick="document.getElementById('file_@p.Id_Pregunta').click()">
                                <i class="fa-solid fa-search me-2"></i>Seleccionar
                            </button>

                            <div id="preview_@p.Id_Pregunta" class="mt-3 d-none">
                                <div class="badge bg-white text-dark border p-2 rounded-3 w-100 text-truncate">
                                    <i class="fa-solid fa-paperclip me-2 text-primary"></i>
                                    <span id="name_@p.Id_Pregunta">archivo.pdf</span>
                                    <span id="size_@p.Id_Pregunta" class="ms-2 text-muted fw-normal" style="font-size: 0.7rem;">(0 MB)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" onclick="prevStep(@i)">
                        <i class="fa-solid fa-arrow-left me-1"></i> Atrás
                    </button>
                    <button type="button" class="btn btn-dark rounded-pill px-5 fw-bold shadow-sm" onclick="nextStep(@i)">
                        @(i == Model.Preguntas.Count ? "Finalizar" : "Siguiente") <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }

        <div class="survey-card text-center" id="step-loading">
            <div class="py-5">
                <div class="spinner-border text-primary mb-4" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <h4 class="fw-bold animate__animated animate__pulse animate__infinite">Guardando tus respuestas...</h4>
                <p class="text-muted">Por favor espera un momento, no cierres la página.</p>
            </div>
        </div>

    </form>
}
</div>

<div class="modal fade" id="modalValidacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 rounded-4 shadow-lg text-center p-4" style="background: rgba(255, 255, 255, 0.98);">
            <div class="mb-3 text-warning">
                <i class="fa-solid fa-circle-exclamation fa-3x animate__animated animate__headShake"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Atención</h5>
            <p class="text-muted small mb-4" id="txtMensajeError">...</p>
            <button type="button" class="btn btn-dark rounded-pill w-100 fw-bold shadow-sm" data-bs-dismiss="modal">Entendido</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/confetti/confetti.browser.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>

    <script>
        window.addEventListener('load', function() {
        if (typeof activarMenu === 'function') {
        activarMenu('menu-herramientas');
        activarMenu('submenu-encuestas');
        }
        });

        var totalSteps = @Model.Preguntas.Count;
        function mostrarError(mensaje) {
        document.getElementById('txtMensajeError').innerText = mensaje;
        var modal = new bootstrap.Modal(document.getElementById('modalValidacion'));
        modal.show();
        }

        // --- Alternar la pantalla de "Iglesia no registrada" ---
        function toggleFaltaIglesia(mostrarMensaje) {
        var msgBox = document.getElementById('msgFaltaIglesia');
        var btnComenzarContainer = document.getElementById('contenedorBtnComenzar');
        var contSelect = document.getElementById('contenedorSelectIglesia');
        var contLinkFalta = document.getElementById('contenedorLinkFaltaIglesia');

        if (mostrarMensaje) {
        // Ocultamos la UI de inicio e ingresamos al modo error
        msgBox.style.display = 'block';
        btnComenzarContainer.style.display = 'none';
        if (contSelect) contSelect.style.display = 'none';
        if (contLinkFalta) contLinkFalta.style.display = 'none';
        } else {
        // Restauramos la UI
        msgBox.style.display = 'none';
        btnComenzarContainer.style.display = 'block';
        if (contSelect) contSelect.style.display = 'block';
        if (contLinkFalta) contLinkFalta.style.display = 'block';
        }
        }

        function nextStep(current) {
        // 0. PREVENIR DOBLE CLIC
        var btnClicked = event ? event.target : null;
        if(btnClicked && btnClicked.tagName === 'BUTTON') {
        btnClicked.style.pointerEvents = 'none';
        }

        // 1. VALIDAR DATOS (PASO 0)
        if(current === 0) {
        var inps = document.getElementById('step-0').querySelectorAll('input[required], select[required]');
        for(var i = 0; i < inps.length; i++) {
        if(!inps[i].value.trim()) {
        mostrarError("Por favor completa todos los datos requeridos antes de iniciar.");
        if(btnClicked) btnClicked.style.pointerEvents = 'auto'; // Reactivar si hay error
        return;
        }
        if(inps[i].tagName === "INPUT" && inps[i].type === "email" && !inps[i].value.includes('\u0040')) {
        mostrarError("El correo electrónico no parece válido.");
        if(btnClicked) btnClicked.style.pointerEvents = 'auto';
        return;
        }
        }
        }
        // 2. VALIDAR PREGUNTAS (PASO 1..N)
        else {
        var step = document.getElementById('step-' + current);
        var hidden = step.querySelector('.val-input');
        if(hidden && hidden.hasAttribute('required-logic') && !hidden.value) {
        mostrarError("Esta pregunta es obligatoria.");
        if(btnClicked) btnClicked.style.pointerEvents = 'auto';
        return;
        }
        }

        // 3. EFECTO VISUAL (BURBUJAS SUAVES AL AVANZAR)
        if(window.event) {
        triggerBurst(window.event.clientX, window.event.clientY);
        }

        // 4. TRANSICIÓN
        var currentEl = document.getElementById('step-' + current);
        currentEl.classList.remove('active');

        setTimeout(() => {
        currentEl.style.display = 'none';

        var next = current + 1;
        var nextEl = document.getElementById('step-' + next);

        if(nextEl) {
        // A. Mostrar siguiente pregunta
        nextEl.style.display = 'block';
        setTimeout(() => nextEl.classList.add('active'), 50);
        if (totalSteps > 0) document.getElementById('progressBar').style.width = ((next/totalSteps)*100) + '%';
        if(btnClicked) btnClicked.style.pointerEvents = 'auto'; // Reactivar botón
        } else {
        // 1. Mostrar pantalla de carga inmediatamente
        var loadingEl = document.getElementById('step-loading');
        loadingEl.style.display = 'block';
        // Pequeñísimo delay de 10ms solo para permitir que el navegador pinte el spinner
        setTimeout(() => loadingEl.classList.add('active'), 10);

        // 2. Ocultar barra progreso
        document.getElementById('trackBar').style.opacity = '0';
                    
        // 3. ENVIAR YA
        var form = document.getElementById('surveyForm');
        if(!form.getAttribute('data-submitting')) {
        form.setAttribute('data-submitting', 'true');
        form.submit();
        }
        }
        }, 300);
        }

        function prevStep(current) {
        var currentEl = document.getElementById('step-' + current);
        currentEl.classList.remove('active');
        setTimeout(() => {
        currentEl.style.display = 'none';
        var prev = current - 1;
        var prevEl = document.getElementById('step-' + prev);
        prevEl.style.display = 'block';
        setTimeout(() => prevEl.classList.add('active'), 50);

        var pct = (totalSteps > 0) ? ((prev/totalSteps)*100) : 0;
        if(prev === 0) pct = 0;
        document.getElementById('progressBar').style.width = pct + '%';
        }, 300);
        }

        // --- HELPERS PARA CAPTURAR VALORES ---
        function setVal(el, val) {
        var card = el.closest('.survey-card');
        if(card) card.querySelector('.val-input').value = val;
        }

        function selectOption(btn, val) {
        var parent = btn.parentElement;
        parent.querySelectorAll('.btn-option').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        setVal(btn, val);
        }

        function toggleCheckbox(btn, val) {
        btn.classList.toggle('selected');
        var icon = btn.querySelector('.check-icon');
        if(btn.classList.contains('selected')) { icon.classList.replace('fa-square','fa-square-check'); }
        else { icon.classList.replace('fa-square-check','fa-square'); }

        var parent = btn.parentElement;
        var selected = [];
        parent.querySelectorAll('.btn-option.selected').forEach(b => selected.push(b.innerText.trim()));
        setVal(btn, selected.join('|'));
        }

        function setRating(star, val) {
        var stars = star.parentElement.querySelectorAll('.star');
        stars.forEach((s, idx) => {
        if(idx < val) s.classList.add('active'); else s.classList.remove('active');
        });
        setVal(star, val);
        }

        function updateEmoji(val, id, input) {
        var emojis = ['😡', '☹️', '😐', '🙂', '🤩'];
        var el = document.getElementById(id);
        if(el) el.innerText = emojis[val - 1];
        setVal(input, val);
        }
        
        // Función para validar el archivo en tiempo real
        function validarArchivo(input, idPregunta) {
        const file = input.files[0];
        const preview = document.getElementById('preview_' + idPregunta);
        const lblName = document.getElementById('name_' + idPregunta);
        const lblSize = document.getElementById('size_' + idPregunta);
        const maxSize = 2 * 1024 * 1024; // 2MB exactos

        if (file) {
        // Validación de tamaño
        if (file.size > maxSize) {
        mostrarError("El archivo es demasiado grande. El límite es de 2 MB.");
        input.value = ""; // Limpiar el input
        preview.classList.add('d-none');
        setVal(input, ""); // Limpiar valor para la validación de 'requerida'
        return;
        }

        // Mostrar feedback visual
        lblName.innerText = file.name;
        const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
        lblSize.innerText = `(${sizeMB} MB)`;
        preview.classList.remove('d-none');
        // Marcamos la pregunta como "contestada" en el input oculto del sistema
        setVal(input, file.name);
        } else {
        preview.classList.add('d-none');
        setVal(input, "");
        }
        }

        /* ==========================================
        EFECTOS VISUALES DE ALTO IMPACTO
        ========================================= */

        // 1. Efecto "Siguiente": EXPLOSIÓN DE BURBUJAS
        function triggerBurst(x, y) {
        const colors = ['#ffb74d', '#4db6ac', '#00bcd4', '#80deea'];
        const particleCount = 10;

        for (let i = 0; i < particleCount; i++) {
        const el = document.createElement('div');
        el.classList.add('nautic-particle');

        el.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        el.style.left = x + 'px';
        el.style.top = y + 'px';
        // Tamaños más variados y GRANDES (entre 8px y 18px)
        const size = Math.random() * 10 + 8;
        el.style.width = size + 'px';
        el.style.height = size + 'px';
        // Física: Explotan más lejos (radio de 150px)
        const angle = Math.random() * Math.PI * 2;
        const velocity = Math.random() * 150 + 50;
        const tx = Math.cos(angle) * velocity;
        const ty = Math.sin(angle) * velocity;
        el.style.setProperty('--tx', tx + 'px');
        el.style.setProperty('--ty', ty + 'px');

        document.body.appendChild(el);

        // Limpiamos después de 1 segundo
        setTimeout(() => el.remove(), 1000);
        }
        }

        // 2. Efecto "Finalizar": TORMENTA DE CELEBRACIÓN
        function triggerCelebration() {
        var duration = 3000;
        // 3 segundos de fiesta
        var end = Date.now() + duration;
        // Colores del tema
        var colors = ['#8C2323', '#DAA520', '#E5952B', '#FFFDF9'];
        (function frame() {
        // Lanza confeti desde la izquierda
        confetti({
        particleCount: 7,
        angle: 60,
        spread: 55,
        origin: { x: 0 },
        colors: colors,
        zIndex: 10000
        });
        // Lanza confeti desde la derecha
        confetti({
        particleCount: 7,
        angle: 120,
        spread: 55,
        origin: { x: 1 },
        colors: colors,
        zIndex: 10000
        });

        // Continuar hasta que acabe el tiempo
        if (Date.now() < end) {
        requestAnimationFrame(frame);
        }
        }());
        }

